CREATE CONSTRAINT ON (n:Entity) ASSERT n.id IS UNIQUE;
CREATE CONSTRAINT ON (n:Network) ASSERT n.id IS UNIQUE;
CREATE CONSTRAINT ON (n:Snapshot) ASSERT n.id IS UNIQUE;
CREATE INDEX ON :Entity(id);
CREATE INDEX ON :Network(id);
CREATE INDEX ON :Snapshot(id);
CREATE INDEX ON :Entity(scope);
CREATE INDEX ON :Network(scope);
CREATE INDEX ON :Entity(unit);
CREATE INDEX ON :Entity(name);
CREATE INDEX ON :Entity(type);
CREATE INDEX ON :Entity(status);
CREATE INDEX ON :Machine(recipe);
CREATE INDEX ON :Entity;
CREATE INDEX ON :Machine;
CREATE INDEX ON :MiningDrill;
CREATE INDEX ON :Belt;
CREATE INDEX ON :Inserter;
CREATE INDEX ON :Chest;
CREATE INDEX ON :FluidEntity;
CREATE INDEX ON :Pole;
CREATE INDEX ON :External;
