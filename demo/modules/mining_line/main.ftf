# Mining line module: burner drills -> belt -> burner inserter -> stone furnace,
# one row per line, rows 4 tiles apart. Instantiate it once per ore patch.
#
# Geometry notes (verified live):
# - Burner drills face east and drop ore one tile north of their center
#   (drill at y=origin, drop at y=origin-0.5). The belt must run under the
#   drop, so it sits at y=origin-0.5, not origin+0.5.
# - Inserter direction is the pickup heading: west picks from the belt (west)
#   and drops east into the furnace, so east would run the flow backwards.
# - burner-inserter has no filter slots (filter_count=0), so there is no
#   whitelist block: safety relies on the belt carrying a single item. Burner
#   arms burn fuel, so every row needs a coal/wood feed like the drills and
#   furnaces.

variable "origin" {
  type        = object({ x = number, y = number })
  description = "Center of the first drill."
}

variable "lines" {
  type    = number
  default = 2
}

resource "burner_drill" "ore" {
  count     = var.lines
  entity    = "burner-mining-drill"
  position  = { x = var.origin.x, y = var.origin.y + 4 * count.index }
  direction = direction.east
}

resource "belt" "ore_feed" {
  count = var.lines
  belt {
    entity = "transport-belt"
    path = [for i in range(3) : {
      x         = var.origin.x + 1.5 + i
      y         = var.origin.y + 4 * count.index - 0.5
      direction = direction.east
    }]
  }
}

resource "inserter" "feed_furnace" {
  count     = var.lines
  entity    = "burner-inserter"
  position  = { x = var.origin.x + 4.5, y = var.origin.y + 4 * count.index - 0.5 }
  direction = direction.west
}

resource "furnace" "smelter" {
  count    = var.lines
  entity   = "stone-furnace"
  position = { x = var.origin.x + 6, y = var.origin.y + 4 * count.index }
}

output "furnaces" {
  description = "The furnace of every line, in line order."
  value       = resource.furnace.smelter
}
