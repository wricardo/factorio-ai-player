"""An item filter with optional quality and comparator."""
type ItemFilter {
  name: String!
  """Quality prototype name; null for filters that carry no quality."""
  quality: String
  """Comparator used by filters that compare instead of matching a name, such as splitters."""
  comparator: String
}

"""RGBA color with components from 0 to 1."""
type Color {
  r: Float!
  g: Float!
  b: Float!
  a: Float!
}

"""Splitter filter and lane priorities. In Factorio 2.0 the output priority selects which output carries the filtered items: a filter with outputPriority none sorts nothing, so the API rejects that combination and defaults outputPriority to left when a filter is set without one. An omitted comparator means the engine default (=)."""
type SplitterSettings {
  filter: ItemFilter
  """none, left, or right."""
  inputPriority: String!
  """none, left, or right."""
  outputPriority: String!
}

"""One signal reference without a value, mirroring SignalInput. type is the same enum as the write input, so a read can be fed straight back into a write: Factorio reports nil for item signals and a lowercase engine name otherwise, and the reader normalizes both to the enum."""
type SignalID {
  type: SignalType!
  name: String!
  """Quality prototype name; null when the engine stores no quality."""
  quality: String
}

"""A circuit condition as the engine stores it, mirroring SignalConditionInput so reads round-trip into writes."""
type CircuitCondition {
  comparator: String
  constant: Float
  firstSignal: SignalID
  secondSignal: SignalID
  """Engine evaluation result at the read tick; ignored on write."""
  fulfilled: Boolean
}

"""Lamp circuit color mode, matching defines.control_behavior.lamp.color_mode."""
enum LampColorMode {
  """Take the lamp color from a color signal (engine value color_mapping)."""
  COLOR_MAPPING
  """Take red, green and blue from separate signals (engine value components)."""
  COMPONENTS
  """Take a packed RGB value from one signal (engine value packed_rgb)."""
  PACKED_RGB
}

"""Lamp color and circuit-driven color state."""
type LampSettings {
  color: Color!
  alwaysOn: Boolean!
  """True when the lamp takes its color from circuit signals."""
  useColors: Boolean!
  """Which circuit signals drive the color. Colors are turned off by useColors, never by this mode."""
  colorMode: LampColorMode!
}

"""Bar limit of one container inventory."""
type ContainerSettings {
  inventory: String!
  """Engine bar index: the index at which the red (blocked) area starts, so allowedSlots is this value minus one. Zero means the inventory has no limit."""
  bar: Int!
  """Usable slot count, derived as bar-1 and clamped to the capacity. Null means no limit; 0 means every slot is blocked."""
  allowedSlots: Int
  """Total slots of the inventory."""
  capacity: Int!
}

"""One logistic request slot."""
type LogisticRequestSlot {
  index: Int!
  name: String
  quality: String
  min: Float!
  """Null means infinite (the engine stores nil for an unlimited request)."""
  max: Float
}

"""One logistic request section of a container."""
type LogisticSection {
  index: Int!
  active: Boolean!
  """Multiplier applied to every slot before the requests are used; 1 for plain request sections."""
  multiplier: Float!
  group: String!
  slots: [LogisticRequestSlot!]!
}

"""Logistic request sections configured on a container."""
type LogisticSettings {
  sections: [LogisticSection!]!
}

"""Train stop name, train limit, priority and color."""
type TrainStopSettings {
  backerName: String!
  """Null means unlimited: the engine stores 4294967295 (maximum) for a stop without a train limit."""
  trainsLimit: Int
  priority: Int!
  color: Color
}

"""Rocket silo payload progress and launch configuration."""
type RocketSiloSettings {
  rocketParts: Int!
  """Engine defines.rocket_silo_status value."""
  rocketSiloStatus: Int!
  sendToOrbitAutomatically: Boolean!
}

"""Constant combinator sections and their constant signals."""
type ConstantCombinatorSettings {
  enabled: Boolean!
  sections: [ConstantCombinatorSection!]!
}

"""One constant combinator section. Section index, active flag, multiplier and group come from LuaLogisticSection."""
type ConstantCombinatorSection {
  index: Int!
  active: Boolean!
  multiplier: Float!
  group: String!
  slots: [ConstantCombinatorSlot!]!
}

"""One constant combinator slot: a signal and the count it emits."""
type ConstantCombinatorSlot {
  index: Int!
  signal: SignalID!
  count: Int!
}

"""Raw control behavior settings and the writable flags this behavior exposes. Null fields mean the behavior has no such setting."""
type CircuitBehaviorSettings {
  behaviorType: Int!
  enabled: Boolean
  circuitEnableDisable: Boolean
  circuitCondition: CircuitCondition
  logisticCondition: CircuitCondition
  readContents: Boolean
  setRecipe: Boolean
  readIngredients: Boolean
  readWorking: Boolean
  """Mining drill: read resource amounts instead of contents."""
  readResources: Boolean
  """Mining drill: defines.control_behavior.mining_drill.resource_read_mode."""
  resourceReadMode: Int
  readAmmo: Boolean
  readLogistics: Boolean
  readRobotStats: Boolean
  """Roboport: defines.control_behavior.roboport.read_items_mode."""
  readItemsMode: Int
  setFilters: Boolean
  readHandContents: Boolean
  """Inserter: defines.control_behavior.inserter.hand_read_mode (hold or pulse)."""
  handReadMode: Int
  """Inserter: signal the circuit-set stack size reads."""
  stackControlSignal: SignalID
  setStackSize: Boolean
  connectToLogisticNetwork: Boolean
  useColors: Boolean
  colorMode: LampColorMode
  lampColor: Color
  """Lamp: per-channel color signals used by COLOR_MAPPING and COMPONENTS."""
  redSignal: SignalID
  greenSignal: SignalID
  blueSignal: SignalID
  rgbSignal: SignalID
  """Transport belt: defines.control_behavior.transport_belt.content_read_mode (pulse, hold, entire_belt_hold)."""
  contentsReadMode: Int
  """Crafter and furnace: broadcast a pulse when the recipe finishes."""
  readRecipeFinished: Boolean
  recipeFinishedSignal: SignalID
  """Crafter and furnace: signal emitted while the machine works."""
  workingSignal: SignalID
  """Crafter and furnace: count building contents in crafting signals."""
  includeInCrafting: Boolean
  """Crafter and furnace: count fuel in crafting signals."""
  includeFuel: Boolean
  """Splitter: circuit controls the filter."""
  setFilter: Boolean
  splitterInputSide: Boolean
  splitterOutputSide: Boolean
  inputLeftCondition: CircuitCondition
  inputRightCondition: CircuitCondition
  outputLeftCondition: CircuitCondition
  outputRightCondition: CircuitCondition
  """Train stop: circuit flags."""
  sendToTrain: Boolean
  readFromTrain: Boolean
  readStoppedTrain: Boolean
  setTrainsLimit: Boolean
  readTrainsCount: Boolean
  stoppedTrainSignal: SignalID
  trainsCountSignal: SignalID
  trainsLimitSignal: SignalID
  setPriority: Boolean
  prioritySignal: SignalID
  """Rocket silo: defines.control_behavior.rocket_silo.read_mode."""
  siloReadMode: Int
  """Logistic container: enable/disable through the logistic condition."""
  circuitConditionEnabled: Boolean
  """Logistic container: defines.control_behavior.logistic_container.exclusive_mode (0 none, 1 send_contents, 2 set_requests)."""
  exclusiveModeOfOperation: Int
}

"""Post-write configuration of one entity, read in the same game tick. Sections are null for prototypes that do not support them."""
type SettingsResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity
  name: String!
  unitNumber: UnitNumber
  position: Position!
  splitter: SplitterSettings
  inserter: InserterSettings
  lamp: LampSettings
  container: ContainerSettings
  logistic: LogisticSettings
  trainStop: TrainStopSettings
  rocketSilo: RocketSiloSettings
  circuit: CircuitBehaviorSettings
  constantCombinator: ConstantCombinatorSettings
}

"""One settings batch read over an area, filter and limit, produced by a single Lua chunk."""
type EntitySettingsPage {
  tick: Float!
  surface: String!
  force: String!
  """Entities sorted by unit number; entities without a unit number sort last by position."""
  entities: [SettingsResult!]!
  """Number of entities the engine matched before the limit was applied."""
  matched: Int!
}

"""One end of a circuit wire."""
type WireEndpoint {
  name: String!
  unitNumber: UnitNumber
  position: Position!
}

"""Result of connecting or disconnecting a circuit wire."""
type WireResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  color: WireColor!
  connected: Boolean!
  from: WireEndpoint!
  to: WireEndpoint!
}

extend type EntityInspection {
  """Engine settings this entity supports, read in one additional snapshot."""
  settings(inventory: String): SettingsResult @goField(forceResolver: true)
}

extend type Query {
  """Reads the settings snapshot of every matching entity in one Lua chunk, replacing the two round trips per entity that entities{inspection{settings}} costs. surface defaults to nauvis and must exist; force defaults to player and must exist, and entities on other forces are skipped instead of failing the whole query. area is required. Optional names and types filter by prototype name and entity type (engine find_entities_filtered semantics, all filters AND-ed), and limit is 1..10000 with the default 50; matched reports how many entities the engine found before the limit was applied and the list is sorted by unit number so repeated calls compare positionally. Each row is the same SettingsResult that EntityInspection.settings returns, including container, logistic, lamp, train stop, rocket silo, circuit behavior and constant combinator sections, with the inventory key selecting which container inventory reports its bar. No actor is resolved and no reach check applies, so this is the batching read for audits."""
  entitySettings(input: EntitySettingsInput!): EntitySettingsPage!
}

extend type Mutation {
  """
  Replaces or clears a splitter's filter and its left/right lane priorities, then returns the post-write snapshot read in the same tick.

  `actor` must name exactly one of `player` or `character` (a character unit number from 1 to 4294967295); the target must be a splitter on that actor's force, addressed either by `unitNumber` alone or by `entity` plus `position` (never both), on `surface` (nauvis by default for a player actor, the character's current surface for a character actor). `inputPriority` and `outputPriority` accept none, left or right; filter quality defaults to normal and an omitted comparator keeps the engine default (=). A filter requires a sorting output: setting `filter` without `outputPriority` defaults the priority to left, while `filter` combined with an explicit `none` is rejected because the filter would be inert. `clear: true` removes the filter and resets both priorities to none and cannot be combined with filter or priorities; at least one of filter, inputPriority, outputPriority or clear is required. Validation failures, unknown targets and non-splitter entities are GraphQL errors; out-of-reach targets are rejected only with FACTORIO_ENFORCE_REACH=1. The result reports the splitter section and an in-game announcement is printed to all players unless `message` overrides it.
  """
  setSplitterSettings(input: SplitterSettingsInput!): SettingsResult!
  """
  Replaces an inserter's filter slots, filter mode, stack size override and belt pickup lanes, returning the post-write snapshot from the same tick.

  Exactly one of `actor.player` or `actor.character` is required; the target must be an inserter on the actor's force, addressed by `unitNumber` or by `entity` + `position`, on nauvis or the character's own surface. Supplying `filters` clears every engine filter slot first and then sets the listed slots, enabling filter use, so any slot you want kept must be included; each index must be at least 1 and within the inserter's `filter_slot_count`, names must be non-empty and quality defaults to normal. `filterMode` is whitelist or blacklist; `stackSizeOverride` is 0-12 where 0 restores automatic; `pickupFromLeftLane`/`pickupFromRightLane` toggle belt lane pickup, and disabling both makes a full belt unusable. `clear: true` removes all filters, turns filter use off, resets the mode to whitelist and the override to 0, and cannot be combined with any other field; an otherwise empty request is rejected. An index outside the inserter's filter slot count fails at write time (non-transactionally, after the initial clear), a non-inserter target fails before any write, and success returns the inserter section plus a generated announcement unless `message` overrides it.
  """
  setInserterSettings(input: InserterSettingsInput!): SettingsResult!
  """
  Sets a lamp's fixed color, always-on flag and circuit-driven color mode, returning the post-write snapshot in the same tick.

  The actor is exactly one player or character and the target must be a lamp on that actor's force, addressed by `unitNumber` or by `entity` + `position` with the usual surface default. Color components must be finite and within 0-1 (alpha defaults to 1), and `colorMode` selects which circuit signals drive the color: COLOR_MAPPING reads one color signal, COMPONENTS reads separate red, green and blue signals, and PACKED_RGB reads one packed RGB number (these are the engine's defines.control_behavior.lamp.color_mode values); colors are switched off only by `useColors: false`, never by a colorMode value. `useColors` and `colorMode` write through the lamp's control behavior, which is created if absent (a persistent save change) and fails when the prototype has none; a request with none of color, alwaysOn, useColors or colorMode is rejected. Success returns the lamp section and prints a generated announcement unless `message` overrides it; validation and target errors are GraphQL errors with no partial write.
  """
  setLampSettings(input: LampSettingsInput!): SettingsResult!
  """
  Sets the slot bar limit of one container inventory, returning the post-write snapshot in the same tick.

  `inventory` defaults to chest and must be chest, fuel, input (crafter_input), output, modules or turret-ammo; the target must be an entity on the actor's force whose inventory supports a bar, otherwise the mutation fails. `allowedSlots` is the number of usable slots: null removes the limit (engine nil), 0 blocks every slot, and a value above the inventory's slot count fails. The engine stores an index instead (the slot where the blocked red area starts), so this mutation writes allowedSlots+1 and the returned container section reports both the raw `bar` index and the derived `allowedSlots`. The actor is exactly one player or character and the target is addressed by `unitNumber` or by `entity` + `position`, on nauvis or the character's current surface. The returned container section reports the resulting bar index, its derived allowedSlots and the inventory capacity, and a generated announcement is printed unless `message` overrides it.
  """
  setContainerBar(input: ContainerBarInput!): SettingsResult!
  """
  Replaces or clears the logistic request sections of a logistic container, returning the post-write snapshot in the same tick.

  The target must be on the actor's force and expose a logistic point (`get_logistic_point`), otherwise the call fails; the actor is exactly one player or character and the entity is addressed by `unitNumber` or by `entity` + `position` with the usual surface default. `sections` replaces every existing section: each is removed and re-added, at most 20 sections are supported, and every request needs an index of at least 1, a non-empty name, an existing quality (normal by default), a non-negative min and either no max (infinite, written as an absent engine max) or a max at least as large as min; reading a slot with an infinite request reports a null max, and empty slots are skipped rather than ending the section. All item and quality prototypes are validated before any section is cleared, so a bad name cannot leave the container empty. `clear: true` removes every section and cannot be combined with `sections`; passing neither is rejected. Success returns the resulting logistic sections and announces a summary unless `message` overrides it.
  """
  setLogisticRequests(input: LogisticRequestsInput!): SettingsResult!
  """
  Sets a train stop's name, train limit, priority and color in one write and returns the post-write snapshot from the same tick.

  The actor is exactly one player or character and the target must be a train-stop on that actor's force, addressed by `unitNumber` or by `entity` + `position`, on nauvis or the character's current surface. Omitted fields keep their current values, and at least one of name, trainsLimit, clearTrainsLimit, priority or color is required; `name` must be non-empty, `trainsLimit` is 0-1000 where 0 routes no trains, `clearTrainsLimit: true` removes the limit entirely (engine nil, an unlimited stop) and cannot be combined with trainsLimit, `priority` is 0-255 with higher values preferred, and color components must be finite and within 0-1 (alpha defaults to 1). A read of an unlimited stop reports a null trainsLimit instead of the engine's 4294967295 sentinel. Validation errors and non-train-stop targets fail the whole mutation before any write. Success returns the trainStop section, including the stop's current name, limit, priority and color, and prints a generated announcement unless `message` overrides it.
  """
  setTrainStop(input: TrainStopInput!): SettingsResult!
  """
  Sets whether a rocket silo sends its finished rocket to orbit automatically, returning the post-write snapshot in the same tick.

  The actor is exactly one player or character and the target must be a rocket-silo on that actor's force, addressed by `unitNumber` or by `entity` + `position`, on nauvis or the character's current surface. `sendToOrbitAutomatically` is required and is written straight to `send_to_orbit_automatically`; it neither launches a rocket nor checks payload readiness. Failures (missing actor, non-silo entity, out-of-reach target when FACTORIO_ENFORCE_REACH=1) are GraphQL errors. On success the rocketSilo section reports the assembled rocket part count, the engine silo status and the new flag, and a generated announcement is printed unless `message` overrides it.
  """
  setRocketSilo(input: RocketSiloInput!): SettingsResult!
  """
  Launches a loaded rocket silo and returns the post-write snapshot in the same tick.

  The actor is exactly one player or character and the target must be a rocket-silo on that actor's force, addressed by `unitNumber` or by `entity` + `position`, on nauvis or the character's current surface. The silo must currently be `waiting_to_launch_rocket`; any other engine status fails with the current status, the `waiting_to_launch_rocket` value and the assembled versus required rocket part count (prototype `rocket_parts_required`, 100 when absent). It cannot bypass payload, landing-pad or space-platform requirements, and a false return from the engine's `launch_rocket` fails with the status again. Success announces "launched rocket from <name><position>" unless `message` overrides it, and the result reports the silo section read after the launch.
  """
  launchRocket(input: RocketLaunchInput!): SettingsResult!
  """
  Writes the supported fields of an entity's control behavior, trying each Factorio 2.0 engine key candidate per flag, and returns the post-write snapshot in the same tick.

  The actor is exactly one player or character and the target must be an entity on that actor's force that can carry a control behavior, addressed by `unitNumber` or by `entity` + `position` with the usual surface default; the behavior is materialized with `get_or_create_control_behavior` on first write (a persistent save change) and the call fails when the prototype has none. `enabled` is read-only in 2.0 and always rejected; use `circuitEnableDisable` with `circuitCondition` or `logisticCondition` instead. Only fields the behavior actually exposes are written. Each flag probes whether any candidate engine key exists: when none does the call fails with "<field> is not supported by this control behavior", and when a key exists but the engine rejects the value the call fails with "<field>: <engine message>" so the caller sees the real cause (invalid signal type or name, unknown comparator, out-of-range mode). Writes already applied in that call stay applied because mutations are not transactional — the keys cover inserter hand read mode and stack control signal, belt content read mode, crafter/furnace recipe-finished, working, include-in-crafting and include-fuel flags, train stop train-limit/priority/count flags with their signals, lamp per-channel color signals, and the logistic container condition and exclusive-mode flags. — and at least one field or `clearConditions` is required; conditions require a comparator and any signal given needs a name (type defaults to item, quality optional), while `colorMode` accepts the LampColorMode values and the integer modes (`siloReadMode`, `resourceReadMode`, `readItemsMode`, `handReadMode`, `contentsReadMode`, `exclusiveModeOfOperation`) must be non-negative engine values. `clearConditions: true` sets every boolean false, zeroes the integer modes and nils all conditions, and cannot be combined with any other field. The result's circuit section reports the behavior type and every writable flag, and a generated announcement is printed unless `message` overrides it.
  """
  setCircuitBehavior(input: CircuitBehaviorInput!): SettingsResult!
  """
  Replaces a constant combinator's enabled flag and every signal section, returning the post-write snapshot read in the same tick.

  The actor is exactly one player or character and the target must be a constant-combinator on that actor's force, addressed by `unitNumber` or by `entity` + `position` with the usual surface default, otherwise the call fails. Sections work like logistic request sections: at most 20 sections, each replacing every existing section, and each slot needs a one-based index within the engine's slot count, a non-empty signal name, a valid signal type (item, fluid, virtual, entity, recipe, space-location, asteroid-chunk or quality), an existing quality (normal by default) and a count from 0 to 2147483647 which becomes the signal's `min` value. `enabled` toggles the combinator output without touching the sections, and `clearSections: true` removes every section and cannot be combined with `sections`. Passing none of enabled, sections or clearSections is rejected. Every signal name and quality is validated before any section is removed, so a bad entry cannot leave the combinator empty. Success returns the constantCombinator section (sections with index, active, multiplier, group and slots) and announces a summary unless `message` overrides it.
  """
  setConstantCombinator(input: SetConstantCombinatorInput!): SettingsResult!
  """
  Connects a red or green circuit wire between two entities and reports the engine's own connectivity check.

  `actor` must be exactly one player or character; `from` and `to` each address a target by `unitNumber` or by `entity` + `position` plus an optional engine `connector` id, defaulting to `circuit_<color>`. Both endpoints' `surface` must be equal, each defaulting to nauvis; with a character actor both entities are then resolved on the character's current surface instead. Each target must be on the actor's force and expose the requested connector, which is created on demand. `color` defaults to RED and must be RED or GREEN, case-insensitively; with FACTORIO_ENFORCE_REACH=1 both endpoints must be within the actor's reach. A false engine result, a missing connector or mismatched surfaces fail the mutation; success announces "connected <COLOR> wire between <from> and <to>" unless `message` overrides it. The result reports tick, surface, force, color as uppercase RED/GREEN, `connected` read back after the operation, and both endpoint names, unit numbers and positions.
  """
  connectWire(input: WireInput!): WireResult!
  """
  Disconnects a red or green circuit wire between two entities and reports the engine's own connectivity check.

  `actor` must be exactly one player or character; `from` and `to` each address a target by `unitNumber` or by `entity` + `position` plus an optional engine `connector` id, defaulting to `circuit_<color>`. Both endpoints' `surface` must be equal, each defaulting to nauvis; with a character actor both entities are then resolved on the character's current surface instead. Each target must be on the actor's force and expose the requested connector, which is created on demand. `color` defaults to RED and must be RED or GREEN, case-insensitively; with FACTORIO_ENFORCE_REACH=1 both endpoints must be within the actor's reach. A false engine result — for example nothing to remove between those connectors — or a missing connector or mismatched surface fails the mutation; success announces "disconnected <COLOR> wire between <from> and <to>" unless `message` overrides it. The result reports tick, surface, force, uppercase color, `connected` read back after the removal (false on success) and both endpoint names, unit numbers and positions.
  """
  disconnectWire(input: WireInput!): WireResult!
}

input ItemFilterInput {
  name: String!
  """Quality prototype name; defaults to normal."""
  quality: String
  comparator: String
}

input ColorInput {
  r: Float!
  g: Float!
  b: Float!
  a: Float
}

"""Signal types accepted by Factorio 2.0 SignalID. Engine names with a dash use an underscore in the enum."""
enum SignalType {
  ITEM
  FLUID
  VIRTUAL
  ENTITY
  RECIPE
  SPACE_LOCATION
  ASTEROID_CHUNK
  QUALITY
}

input SignalInput {
  """Engine signal type: the name must exist in that prototype type, so an iron plate is ITEM while steam is FLUID and signal-A is VIRTUAL."""
  type: SignalType = ITEM
  name: String!
  quality: String
}

input SignalConditionInput {
  """Comparison operator, for example <, =, > or >=."""
  comparator: String!
  constant: Float
  firstSignal: SignalInput
  secondSignal: SignalInput
}

input InserterFilterInput {
  """One-based filter slot index."""
  index: Int!
  name: String!
  quality: String
  comparator: String
}

input SplitterSettingsInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Filter items must match; omitted keeps the current filter. When a filter is set, outputPriority defaults to left and an explicit none is rejected because the filter would be inert. An omitted comparator keeps the engine default (=)."""
  filter: ItemFilterInput
  """none, left, or right."""
  inputPriority: String
  """none, left, or right."""
  outputPriority: String
  """Remove the filter and reset both priorities to none."""
  clear: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input InserterSettingsInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Replaces every filter slot; slots not listed are cleared."""
  filters: [InserterFilterInput!]
  """whitelist or blacklist."""
  filterMode: String
  """Stack size override; 0 restores automatic."""
  stackSizeOverride: Int
  """Allow or forbid taking from the left lane of a belt source. Disabling both lane flags makes a full belt unusable for the inserter."""
  pickupFromLeftLane: Boolean
  """Allow or forbid taking from the right lane of a belt source."""
  pickupFromRightLane: Boolean
  """Clear every filter slot and reset the mode and stack size override."""
  clear: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input LampSettingsInput {
  actor: ActorInput!
  target: EntityRefInput!
  color: ColorInput
  alwaysOn: Boolean
  """Take the color from circuit signals instead of the fixed color."""
  useColors: Boolean
  """Which circuit signals drive the color. This never turns colors off; use useColors for that."""
  colorMode: LampColorMode
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input ContainerBarInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Inventory key: input, output, fuel, chest, modules or turret-ammo."""
  inventory: String = "chest"
  """Number of usable slots; null removes the limit (engine nil) and 0 blocks every slot. Never an engine bar index: the write sends allowedSlots+1."""
  allowedSlots: Int
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input LogisticRequestInput {
  """One-based slot index inside the section."""
  index: Int!
  name: String!
  quality: String
  min: Int = 0
  """Omitted or null means infinite: no engine max is written for that slot."""
  max: Int
}

input LogisticSectionInput {
  slots: [LogisticRequestInput!]!
}

input LogisticRequestsInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Replaces every request section on the container when given."""
  sections: [LogisticSectionInput!]
  """Remove every request section."""
  clear: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input TrainStopInput {
  actor: ActorInput!
  target: EntityRefInput!
  """New stop name; omitted keeps the current name."""
  name: String
  """Maximum trains routed to the stop; 0 routes none. Cannot be combined with clearTrainsLimit."""
  trainsLimit: Int
  """Removes the train limit entirely (engine nil), leaving an unlimited stop. Cannot be combined with trainsLimit."""
  clearTrainsLimit: Boolean
  """Stop priority from 0 to 255; higher values are preferred."""
  priority: Int
  color: ColorInput
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input RocketSiloInput {
  actor: ActorInput!
  target: EntityRefInput!
  sendToOrbitAutomatically: Boolean!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input RocketLaunchInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input CircuitBehaviorInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Read-only in Factorio 2.0; always rejected. Use circuitEnableDisable with circuitCondition or logisticCondition."""
  enabled: Boolean
  circuitEnableDisable: Boolean
  circuitCondition: SignalConditionInput
  logisticCondition: SignalConditionInput
  """Clear both conditions and switch every writable flag off."""
  clearConditions: Boolean = false
  readContents: Boolean
  setRecipe: Boolean
  readIngredients: Boolean
  readWorking: Boolean
  """Mining drill: read resource amounts instead of contents."""
  readResources: Boolean
  """Mining drill: defines.control_behavior.mining_drill.resource_read_mode."""
  resourceReadMode: Int
  readAmmo: Boolean
  readLogistics: Boolean
  readRobotStats: Boolean
  """Roboport: defines.control_behavior.roboport.read_items_mode."""
  readItemsMode: Int
  setFilters: Boolean
  readHandContents: Boolean
  """Inserter: defines.control_behavior.inserter.hand_read_mode (hold or pulse)."""
  handReadMode: Int
  """Inserter: signal the circuit-set stack size reads; without it setStackSize has no effect."""
  stackControlSignal: SignalInput
  setStackSize: Boolean
  connectToLogisticNetwork: Boolean
  useColors: Boolean
  colorMode: LampColorMode
  """Lamp: per-channel color signals used by COLOR_MAPPING and COMPONENTS."""
  redSignal: SignalInput
  greenSignal: SignalInput
  blueSignal: SignalInput
  rgbSignal: SignalInput
  """Transport belt: defines.control_behavior.transport_belt.content_read_mode (pulse, hold, entire_belt_hold)."""
  contentsReadMode: Int
  """Crafter and furnace: broadcast a pulse when the recipe finishes."""
  readRecipeFinished: Boolean
  recipeFinishedSignal: SignalInput
  """Crafter and furnace: signal emitted while the machine works."""
  workingSignal: SignalInput
  """Crafter and furnace: count building contents in crafting signals."""
  includeInCrafting: Boolean
  """Crafter and furnace: count fuel in crafting signals."""
  includeFuel: Boolean
  """Splitter: circuit controls the filter and each lane's input/output side."""
  setFilter: Boolean
  splitterInputSide: Boolean
  splitterOutputSide: Boolean
  inputLeftCondition: SignalConditionInput
  inputRightCondition: SignalConditionInput
  outputLeftCondition: SignalConditionInput
  outputRightCondition: SignalConditionInput
  """Train stop circuit flags."""
  sendToTrain: Boolean
  readFromTrain: Boolean
  readStoppedTrain: Boolean
  setTrainsLimit: Boolean
  readTrainsCount: Boolean
  stoppedTrainSignal: SignalInput
  trainsCountSignal: SignalInput
  trainsLimitSignal: SignalInput
  setPriority: Boolean
  prioritySignal: SignalInput
  """Rocket silo: defines.control_behavior.rocket_silo.read_mode."""
  siloReadMode: Int
  """Logistic container: enable/disable through the logistic condition."""
  circuitConditionEnabled: Boolean
  """Logistic container: defines.control_behavior.logistic_container.exclusive_mode (0 none, 1 send_contents, 2 set_requests)."""
  exclusiveModeOfOperation: Int
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input ConstantCombinatorSlotInput {
  """One-based slot index inside the section."""
  index: Int!
  signal: SignalInput!
  """Signal count, written as the engine slot min; 0 to 2147483647."""
  count: Int!
}

input ConstantCombinatorSectionInput {
  """One-based section index; sections are added in list order."""
  index: Int
  """Omitted keeps the engine default true."""
  active: Boolean
  """Multiplier applied to every slot before the signals are used; omitted keeps the engine value."""
  multiplier: Float
  """Section group name; omitted or empty writes no group."""
  group: String
  slots: [ConstantCombinatorSlotInput!]!
}

input SetConstantCombinatorInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Turns the constant combinator output on or off; omitted keeps the current state."""
  enabled: Boolean
  """Replaces every signal section when given; at most 20 sections."""
  sections: [ConstantCombinatorSectionInput!]
  """Removes every section; cannot be combined with sections."""
  clearSections: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input EntitySettingsInput {
  surface: String! = "nauvis"
  force: String! = "player"
  area: FactoryAreaInput!
  """Prototype names to include; omitted means every name."""
  names: [String!]
  """Entity types to include, for example container, inserter, assembling-machine; omitted means every type."""
  types: [String!]
  """Maximum rows returned, 1 through 10000."""
  limit: Int! = 50
  """Container inventory key used for the bar section: chest, fuel, input, output, modules or turret-ammo."""
  inventory: String = "chest"
}

input WireEndpointInput {
  target: EntityRefInput!
  """Engine wire connector id, for example circuit_red, circuit_green, combinator_output_red. Defaults to circuit_<color>."""
  connector: String
}

input WireInput {
  actor: ActorInput!
  from: WireEndpointInput!
  to: WireEndpointInput!
  color: WireColor! = RED
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
