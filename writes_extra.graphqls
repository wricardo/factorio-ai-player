extend type Mutation {
  """Drops items from the acting character's inventory as a ground stack or onto a transport belt tile, so lines can be seeded without an inserter."""
  dropItem(input: DropItemInput!): DropItemResult!
}

enum DropTarget {
  GROUND
  BELT
}

"""Drop items from one selected actor at a finite position."""
input DropItemInput {
  actor: ActorInput!
  surface: String = "nauvis"
  item: String!
  quality: String
  count: Float! = 1
  position: PositionInput!
  target: DropTarget! = GROUND
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type DropItemResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  item: String!
  quality: String!
  requested: Float!
  moved: Float!
  position: Position!
  """Transport line (1 or 2) that received the items; zero for a ground drop."""
  line: Int!
}
