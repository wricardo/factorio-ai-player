extend type FactoryMachine {
  """Surface this machine is on."""
  surface: String!
  """Force this machine belongs to."""
  force: String!
  """Engine unit number; null when the engine did not assign one."""
  unitNumber: UnitNumber
  """Computed by the machines page in the same Lua snapshot as the row, so selecting it adds no call per machine. Carries ingredient demand, theoretical throughput or mining rate, blocking status, burner fuel state and electric state together."""
  diagnostics: MachineDiagnostics!
}

extend type LogisticsEndpoint {
  """Surface this endpoint is on."""
  surface: String!
  """Full current inserter configuration in a separate snapshot; null for non-inserters."""
  inserterSettings: InserterSettings @goField(forceResolver: true)
  """Full inspection of the entity this endpoint represents, in a separate snapshot; null if the entity no longer exists."""
  inspection: EntityInspection @goField(forceResolver: true)
}

type MachineDiagnostics {
  tick: Float!
  """Current recipe, or for furnaces the remembered previous recipe when no recipe is selected."""
  recipe: String
  recipeQuality: String
  """CURRENT when the machine holds this recipe now, PREVIOUS when only an idle furnace's previous_recipe matched, null when no recipe applies."""
  recipeSource: RecipeSource
  """Demand for one NEXT craft from input inventories and compatible input fluid boxes. Excludes ingredients already consumed by an in-progress craft. Null if no crafting recipe is selected."""
  shortfall: [MachineIngredientDemand!]
  """Null for entities without a crafting recipe or mining target. Never a measured production rate."""
  throughput: MachineTheoreticalThroughput
  """Set when no rate could be derived: no current or previous recipe, a furnace that never smelted, a drill without a target, or a non-positive recipe duration."""
  throughputUnavailableReason: String
  """Mining rate for drilling machines; null for everything else."""
  mining: MachineMiningRate
  """Burner fuel state for entities with a burner energy source; null for electric-only and non-energy entities."""
  burner: MachineBurnerState
  blocked: MachineBlockedReason!
  power: MachinePowerState!
}

type MachineMiningRate {
  """Resource prototype name of the current mining target."""
  target: String!
  """Remaining resource amount of the current mining target, in engine units; null for infinite resources."""
  amount: Float
  """Expected item units per second: mining_speed times (1+speed_bonus) divided by mining_time, multiplied by the summed expected item product yield of the target. Excludes productivity, depletion and fluid byproducts."""
  theoreticalUnitsPerSecond: Float
  """Engine mining productivity bonus, observed separately and NOT included in theoreticalUnitsPerSecond."""
  productivityBonus: Float
}

type MachineIngredientDemand {
  name: String!
  type: String!
  """Exact selected recipe quality for items; null for fluids, which have no quality."""
  quality: String
  requiredPerCraft: Float!
  available: Float!
  missing: Float!
  minimumTemperatureCelsius: Float
  maximumTemperatureCelsius: Float
}

type MachineTheoreticalThroughput {
  """Current engine crafting speed divided by recipe duration. Assumes continuous ingredients, output space and full power; excludes tick quantization and downtime."""
  theoreticalCraftsPerSecond: Float!
  recipeDurationSeconds: Float!
  craftingSpeed: Float!
  """Expected BASE recipe yield per second, including probability, random amounts and extra-count fractions. Excludes productivity extra crafts and quality distribution. Item units are items/s; fluid units are fluid units/s."""
  theoreticalBaseProducts: [MachineTheoreticalProductRate!]!
  """Engine productivity bonus, observed separately and NOT included in base product rates."""
  productivityBonus: Float
  """Unknown in a single snapshot. Null, never a fabricated zero."""
  actualCraftsPerSecond: Float
}

type MachineTheoreticalProductRate {
  name: String!
  type: String!
  expectedBaseUnitsPerCraft: Float!
  theoreticalBaseUnitsPerSecond: Float!
}

type MachineBurnerState {
  """Fuel inventory contents for this burner; each entry is one item stack, sorted by name then quality."""
  fuelItems: [InventoryStack!]!
  """Energy left in the item currently burning, in joules."""
  remainingBurningFuelJoules: Float!
  """Item name of the currently burning fuel, or null when nothing is burning."""
  currentlyBurning: String
  """Seconds until the burner stops for lack of fuel: fuel inventory energy plus remaining burning fuel divided by current max energy usage. Null when the usage is unknown or zero."""
  estimatedSecondsOfFuel: Float
}

enum MachineBlockCategory {
  NONE
  MISSING_RECIPE
  MISSING_INGREDIENTS
  MISSING_RESEARCH
  MISSING_FUEL
  MISSING_POWER
  OUTPUT_BLOCKED
  DISABLED
  RESOURCE_DEPLETED
  OTHER
}

type MachineBlockedReason {
  """NONE for working/normal; MISSING_RECIPE for no_recipe; MISSING_INGREDIENTS for no_ingredients, item_ingredient_shortage, fluid_ingredient_shortage, missing_science_packs, missing_required_fluid, no_input_fluid and low_input_fluid; MISSING_RESEARCH for no_research_in_progress and recipe_not_researched; MISSING_FUEL for no_fuel; MISSING_POWER for no_power, low_power, not_plugged_in_electric_network and recharging_after_power_outage; OUTPUT_BLOCKED for full_output, full_burnt_result_output, waiting_for_space_in_destination and not_enough_space_in_output; DISABLED for disabled_by_control_behavior, disabled_by_script, disabled, frozen, paused and marked_for_deconstruction; RESOURCE_DEPLETED for no_minable_resources; OTHER for any other or future engine status."""
  category: MachineBlockCategory!
  """Unmodified engine status name; unknown future statuses remain visible with category OTHER."""
  rawStatusName: String
  rawStatusCode: Int
  """Action suggested only for recognized engine conditions; null for NONE or OTHER."""
  suggestedAction: String
}

type MachinePowerState {
  electric: Boolean!
  """Electric network membership, not proof that a producer exists or supplies enough power. Null for non-electric machines."""
  connected: Boolean
  networkId: ID
  """Engine is_connected_to_electric_network(): network contains at least one potential producer. Not power satisfaction."""
  connectedToProducingNetwork: Boolean
  """Null: Factorio 2.0 exposes no instantaneous per-machine demand/satisfaction ratio. Stored energy is not satisfaction."""
  satisfaction: Float
  satisfactionUnavailableReason: String!
}

type InserterSettings {
  tick: Float!
  filterSlotCount: Int!
  """Every one-based slot, including empty slots; no pagination or truncation."""
  filterSlots: [InserterFilterSlot!]!
  useFilters: Boolean!
  filterMode: String
  """Engine override; zero means automatic, not zero carrying capacity."""
  stackSizeOverride: Int!
  """Engine active state, including script, circuit, recipe, freezing and deconstruction disabling."""
  active: Boolean!
  """Whether the inserter may take from the left lane of a belt source. Both flags false is a common reason a full belt still reports waiting_for_source_items."""
  pickupFromLeftLane: Boolean!
  """Whether the inserter may take from the right lane of a belt source."""
  pickupFromRightLane: Boolean!
  """Null when no control behavior exists. Reading never creates one."""
  circuit: InserterCircuitSettings
}

type InserterFilterSlot {
  index: Int!
  name: String
  quality: String
  comparator: String
}

type InserterCircuitSettings {
  """Whether control behavior currently permits operation. Other causes may still make InserterSettings.active false."""
  enabled: Boolean!
  """Whether the enable/disable circuit-condition checkbox is selected."""
  circuitEnableDisable: Boolean!
  disabledByControlBehavior: Boolean!
  setFilters: Boolean!
  readHandContents: Boolean!
  handReadMode: Int!
  setStackSize: Boolean!
  """Shared SignalID shape: signal type, name and optional quality."""
  stackControlSignal: SignalID
  connectToLogisticNetwork: Boolean!
  """Shared CircuitCondition shape: comparator, constant and both signals, with the engine's evaluated result."""
  circuitCondition: CircuitCondition
  logisticCondition: CircuitCondition
}
