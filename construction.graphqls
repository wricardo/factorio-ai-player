extend type Query {
  """Reports logistic networks whose roboports lie on the surface or area: robot counts, contents and point counts. Separate snapshot per network."""
  logisticNetworks(input: LogisticNetworksInput = {}): LogisticNetworkPage!
  """Lists entities currently registered with the force construction manager for deconstruction or upgrade. Omit area to scan the whole surface; the engine filter is cheap because only marked entities are matched."""
  constructionOrders(input: ConstructionOrdersInput = {}): ConstructionOrderPage!
}

"""Orders are per force in the engine, but the filter matches any force; force is reported per entity."""
input ConstructionOrdersInput {
  surface: String! = "nauvis"
  """Optional area (at most 256 tiles per side); omitted scans the whole surface."""
  area: FactoryAreaInput
  state: ConstructionOrderState! = DECONSTRUCTION
  limit: Int! = 100
  offset: Int! = 0
}

enum ConstructionOrderState {
  DECONSTRUCTION
  """Upgrade orders also report the target prototype and quality."""
  UPGRADE
}

type ConstructionOrder {
  name: String!
  type: String
  position: Position!
  direction: Int
  unitNumber: UnitNumber
  """Force that owns the entity; neutral entities (trees, rocks) report their own force, if any."""
  force: String
  """Upgrade target prototype and quality for UPGRADE orders; null for deconstruction."""
  upgradeTarget: String
  upgradeQuality: String
}

type ConstructionOrderPage {
  tick: Float!
  surface: String!
  state: ConstructionOrderState!
  pageInfo: PageInfo!
  orders: [ConstructionOrder!]!
}

input LogisticNetworksInput {
  surface: String! = "nauvis"
  force: String! = "player"
  area: FactoryAreaInput
  """Optional engine network id; omitted networks cover every roboport on the surface."""
  networkId: ID
  limit: Int! = 100
  offset: Int! = 0
}

type LogisticNetworkPage {
  tick: Float!
  surface: String!
  force: String!
  pageInfo: PageInfo!
  networks: [LogisticNetworkInfo!]!
}

type LogisticNetworkInfo {
  id: ID!
  force: String!
  surface: String!
  cells: Int!
  logisticRobots: RobotCount!
  constructionRobots: RobotCount!
  contents: [InventoryStack!]!
  requesterPoints: Int!
  providerPoints: Int!
}

type RobotCount {
  total: Int!
  available: Int!
}

extend type Mutation {
  """Turns entity ghosts inside an area into real entities. Script revival bypasses items and construction robots, so this is an explicit sandbox shortcut; missing materials are reported, never consumed."""
  buildGhosts(input: BuildGhostsInput!): BuildGhostsResult!
}

"""Area limits are positive and at most 256 tiles per side. limit is 1 through 1000."""
input BuildGhostsInput {
  actor: ActorInput
  force: String = "player"
  surface: String = "nauvis"
  area: FactoryAreaInput!
  mode: BuildGhostsMode! = REVIVE
  limit: Int! = 100
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

enum BuildGhostsMode {
  """Revive ghosts through the engine and raise built events. Script revival bypasses items and construction robots, so this is an explicit sandbox shortcut."""
  REVIVE
  """Revive ghosts without raising built events or creating smoke. Same sandbox semantics as REVIVE."""
  SILENT
}

type BuildGhostsResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity
  mode: BuildGhostsMode!
  revived: Int!
  failed: Int!
  missing: [ItemRequest!]!
  entities: [PlacedEntity!]!
  errors: [BatchError!]!
}
