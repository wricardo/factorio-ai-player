extend type EntityInspection {
  """Engine unit number of the inspected entity, when it has one."""
  unitNumber: UnitNumber
  """Engine direction code, when the entity exposes one. 0 north, 4 east, 8 south, 12 west; inserts and machinery may use the full 0-15 range."""
  direction: Int
  """Typed arithmetic or decider combinator parameters; null for other entities."""
  combinatorParameters: CombinatorParameters
  """Unmodified JSON encoding of engine parameters for unsupported parameter-bearing entities."""
  parametersRawJSON: String
  """JSON encoding of the entity tags, when readable."""
  tagsJSON: String
  """Engine name tag, when the entity supports one."""
  nameTag: String
  """Counterpart of an underground belt or pipe, when paired."""
  undergroundNeighbour: PlacedEntity
  """Belt neighbours reported by the engine, when the entity is belt connectable."""
  beltNeighbours: [PlacedEntity!]
  """Fluidbox neighbours reported by the engine, when the entity has fluidboxes."""
  fluidboxNeighbours: [PlacedEntity!]
}

extend type Mutation {
  """Replaces one entity's tags with a single JSON object; the payload is parsed and shape-checked before any game command runs. Address the entity by unitNumber on the actor's surface, or by prototype name plus exact centre position on the actor's force; the actor must select exactly one player or character, and out-of-reach targets are rejected only when FACTORIO_ENFORCE_REACH is enabled. Factorio 2.0.77 persists tags only for some prototypes, so the write is read back and compared: a prototype that drops them fails with guidance toward blueprint/ghost tags instead of silently discarding the payload. Returns the post-write entity snapshot (name, unit number, position, tagsJSON, and parameters when the entity has any). Emits one in-game notification unless message overrides it."""
  setEntityTags(input: EntityTagsInput!): EntityMetaResult!
  """Sets one entity's map name tag, or clears it when nameTag is the empty string; the entity must accept name_tag. Address the entity by unitNumber on the actor's surface, or by prototype name plus exact centre position on the actor's force, with an actor naming exactly one player or character, and out-of-reach targets rejected only when FACTORIO_ENFORCE_REACH is enabled. Returns the post-write snapshot including nameTag, and emits an in-game notification that says set or cleared unless message overrides it."""
  setNameTag(input: EntityNameTagInput!): EntityMetaResult!
  """Replaces the control behavior parameters of one arithmetic or decider combinator. parameters must fill exactly one family matching the target's engine type, otherwise the write is rejected; arithmetic needs a whitelisted operation (*, /, +, -, %, ^, <<, >>, AND, OR, XOR) and an output signal with firstSignal/firstConstant and secondSignal/secondConstant mutually exclusive, while decider needs 1..1000 conditions and 1..1000 outputs with optional comparator (including <=, >=, !=), and/or compareType, and mutually exclusive secondSignal and constant per condition. The target is addressed by unitNumber or by prototype name plus exact centre position on the actor's force, and the result is the post-write snapshot with the stored combinatorParameters. Emits one in-game notification unless message overrides it."""
  setCombinatorParameters(input: SetCombinatorParametersInput!): EntityMetaResult!
}

"""Replace one entity's tags."""
input EntityTagsInput {
  actor: ActorInput!
  target: EntityRefInput!
  tagsJSON: String!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""Set or clear one entity's map name tag."""
input EntityNameTagInput {
  actor: ActorInput!
  target: EntityRefInput!
  nameTag: String!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}


"""Circuit network selection. Omitted flags default to both networks in Factorio."""
type CircuitNetworkSelection {
  red: Boolean!
  green: Boolean!
}

type ArithmeticCombinatorParameters {
  firstSignal: SignalID
  firstSignalNetworks: CircuitNetworkSelection
  firstConstant: Int
  secondSignal: SignalID
  secondSignalNetworks: CircuitNetworkSelection
  secondConstant: Int
  operation: String!
  """Null on a freshly placed combinator: the engine stores no output signal yet."""
  outputSignal: SignalID
}

type DeciderCombinatorCondition {
  firstSignal: SignalID
  firstSignalNetworks: CircuitNetworkSelection
  secondSignal: SignalID
  secondSignalNetworks: CircuitNetworkSelection
  constant: Int
  comparator: String
  compareType: String
}

type DeciderCombinatorOutput {
  signal: SignalID
  copyCountFromInput: Boolean!
  constant: Int
  networks: CircuitNetworkSelection
}

type DeciderCombinatorParameters {
  conditions: [DeciderCombinatorCondition!]!
  outputs: [DeciderCombinatorOutput!]!
}

"""Exactly one field is populated."""
type CombinatorParameters {
  arithmetic: ArithmeticCombinatorParameters
  decider: DeciderCombinatorParameters
}

input CircuitNetworkSelectionInput {
  red: Boolean = true
  green: Boolean = true
}

input ArithmeticCombinatorParametersInput {
  firstSignal: SignalInput
  firstSignalNetworks: CircuitNetworkSelectionInput
  firstConstant: Int
  secondSignal: SignalInput
  secondSignalNetworks: CircuitNetworkSelectionInput
  secondConstant: Int
  operation: String!
  outputSignal: SignalInput!
}

input DeciderCombinatorConditionInput {
  firstSignal: SignalInput
  firstSignalNetworks: CircuitNetworkSelectionInput
  secondSignal: SignalInput
  secondSignalNetworks: CircuitNetworkSelectionInput
  constant: Int
  comparator: String
  compareType: String
}

input DeciderCombinatorOutputInput {
  signal: SignalInput!
  copyCountFromInput: Boolean = true
  constant: Int
  networks: CircuitNetworkSelectionInput
}

input DeciderCombinatorParametersInput {
  conditions: [DeciderCombinatorConditionInput!]!
  outputs: [DeciderCombinatorOutputInput!]!
}

"""Provide exactly one parameter family matching target combinator type."""
input CombinatorParametersInput {
  arithmetic: ArithmeticCombinatorParametersInput
  decider: DeciderCombinatorParametersInput
}

input SetCombinatorParametersInput {
  actor: ActorInput!
  target: EntityRefInput!
  parameters: CombinatorParametersInput!
  """Print this text in-game to all connected players instead of generated notification."""
  message: String
}

type EntityMetaResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity
  name: String!
  unitNumber: UnitNumber
  position: Position!
  combinatorParameters: CombinatorParameters
  parametersRawJSON: String
  tagsJSON: String
  nameTag: String
}
