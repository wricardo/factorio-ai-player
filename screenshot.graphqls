extend type Mutation {
  """Captures a native Factorio screenshot by delegating rendering to one connected graphical client and returns only after the PNG has been verified on the GraphQL host, so the call blocks while the client renders. The player must be connected and is used both as the viewpoint and as the rendering client; surface defaults to nauvis and must exist, position must be finite, width and height are 1 through 4096 (1 through 2048 when antiAlias is on), zoom must be finite and greater than zero, daytime when given must be 0 through 1, and waterTick must be non-negative. The output path is always generated server-side as factorio-ai-player/screenshot-<nanotime>-<random>.png beneath the graphical client's script-output directory, resolved from FACTORIO_SCREENSHOT_DIR and otherwise ~/factorio-client/script-output; callers cannot choose it, and an existing file at the generated path is rejected before the engine is asked. Verification polls the file until it decodes as PNG with exactly the requested width and height and carries the IEND trailer, up to a hard 10 second ceiling, so a partially written file keeps waiting and a missing or dimension-mismatched file ends the call with an error. Any validation, engine or verification failure is a GraphQL error with no announcement; success returns tick, surface, player, the path relative to script-output, width, height and byte count, and announces a generated summary unless message overrides it."""
  screenshot(input: ScreenshotInput!): ScreenshotResult!
}

"""Native screenshot settings. Output path is generated by server and cannot be supplied by caller."""
input ScreenshotInput {
  """Connected graphical player used for both screenshot viewpoint and client-side rendering delegation."""
  player: String!
  surface: String! = "nauvis"
  position: PositionInput!
  width: Int! = 1920
  height: Int! = 1080
  zoom: Float! = 1
  showGui: Boolean! = false
  showEntityInfo: Boolean! = true
  antiAlias: Boolean! = false
  hideClouds: Boolean! = false
  hideFog: Boolean! = false
  daytime: Float
  waterTick: Int
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type ScreenshotResult {
  tick: Float!
  surface: String!
  player: String!
  """Path relative to the graphical client's script-output directory."""
  path: String!
  width: Int!
  height: Int!
  bytes: Int!
}
