directive @goField(forceResolver: Boolean, name: String, omittable: Boolean) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

type Query {
  """Returns the current game tick and connected players."""
  status: Status!
  """Returns one entity snapshot by shared unit-number or prototype-position reference."""
  entity(input: EntityRefInput!): EntitySnapshot!
  """Finds entities around a position with deterministic ordering and standard pagination."""
  nearby(input: NearbyInput = {}): Nearby!
  """Returns player or character state."""
  player(input: ActorInput!): Actor!
  """Returns the actor's main inventory."""
  inventory(input: ActorInput!): ActorInventory!
  """Returns the actor's crafting queue."""
  queue(input: ActorInput!): CraftQueue!
  """Returns a force recipe and its craftable count for the actor."""
  recipe(input: RecipeInput!): Recipe!
  """Inspects a matching entity using the actor's force."""
  inspect(input: InspectInput!): EntityInspection!
  """Returns production and machine summaries from separate game snapshots."""
  factoryOverview(input: FactoryOverviewInput = {}): FactoryOverview!
  """Returns production statistics for a surface, force, and time window."""
  production(input: FactoryOverviewInput = {}): FactoryProduction!
  """Returns a page of machines and machine status summaries."""
  machines(input: MachinesInput = {}): MachinePage!
  """Returns entities in an area with optional prototype-name and type filters."""
  entities(input: EntitiesInput!): EntityPage!
  """Returns transport-belt lane contents in an area."""
  belts(input: BeltsInput!): BeltPage!
  """Returns characters across a whole surface, including detached characters and connected players' characters."""
  characters(input: CharactersInput = {}): CharacterPage!
}
"""Mutating fields act as the selected actor's character. Reachability is not enforced by default, matching Factorio's administrative script API; set FACTORIO_ENFORCE_REACH=1 to enforce build and interaction distance, in which case entity-addressed fields reject out-of-reach targets. Batch operations report per-target reach failures instead of aborting."""
type Mutation {
  """Creates a detached character near a disconnected player and transfers their main inventory."""
  characterCreate(input: CharacterCreateInput!): ActionResult!
  """Transfers a detached character's main inventory back to a disconnected player and destroys the character."""
  characterReturn(input: CharacterReturnInput!): ActionResult!
  """Creates a detached character with no player, empty inventories, and its own reach at the closest non-colliding position to finite coordinates within 10 tiles."""
  characterSpawn(input: CharacterSpawnInput!): ActionResult!
  """Creates a character for a connected player that controls none (for example a sandbox god controller), so player-addressed operations have reach. The player's main inventory is untouched; a player that already controls a character is rejected."""
  playerRestoreCharacter(input: PlayerRestoreInput!): ActionResult!
  """Places an entity using one normal-quality item from the actor's main inventory."""
  place(input: PlaceInput!): ActionResult!
  """Places the same normal-quality item at each position, continuing past failures and returning counts."""
  placeMany(input: PlaceManyInput!): PlaceManyResult!
  """Places one tile item (landfill, concrete, foundation) when its prototype placement condition allows it."""
  placeTile(input: PlaceTileInput!): PlaceTileResult!
  """Creates a blueprint string from blueprintable entities and optional tiles in an area."""
  createBlueprint(input: CreateBlueprintInput!): BlueprintResult!
  """Creates a blueprint string from explicit entities and tiles without copying the world."""
  createBlueprintFromEntities(input: CreateBlueprintFromEntitiesInput!): BlueprintFromEntitiesResult!
  """Imports a blueprint string and places its ghosts; construction requires bots or manual building."""
  placeBlueprint(input: PlaceBlueprintInput!): BlueprintPlaceResult!
  """Transfers normal-quality fuel from the actor's main inventory to an entity."""
  fuel(input: FuelInput!): ActionResult!
  """Queues enabled recipe crafts; optional wait returns when the actor's entire queue drains or timeout expires."""
  craft(input: CraftInput!): ActionResult!
  """Cancels crafts at a one-based queue index and returns the remaining queue; dependent later crafts may also cancel."""
  cancelCraft(input: CancelCraftInput!): CraftQueue!
  """Instantly removes trees and rock-named simple entities inside a bounded area; yields no mining drops."""
  clearArea(input: ClearAreaInput!): ClearAreaResult!
  """Mines trees and rock-named simple entities with normal drops. When reach enforcement is enabled, unreachable or failed entities remain."""
  harvestArea(input: HarvestAreaInput!): HarvestAreaResult!
  """Picks up dropped item stacks in bounds; partial stacks stay on ground. With reach enforcement enabled, out-of-reach stacks are counted and left."""
  pickupArea(input: PickupAreaInput!): PickupAreaResult!
  """Places deconstruction orders for every deconstructible entity in a bounded area, so the force's construction robots remove them and leave ghosts; returns the number of new orders."""
  deconstructArea(input: DeconstructAreaInput!): DeconstructionResult!
  """Cancels deconstruction orders in a bounded area for the force."""
  cancelDeconstructArea(input: DeconstructAreaInput!): DeconstructionResult!
  """Places deconstruction orders on up to 200 explicit entities, targeting each by unit number or by prototype name and center coordinates."""
  deconstructEntities(input: DeconstructEntitiesInput!): DeconstructionResult!
  """Cancels deconstruction orders on up to 200 explicit entities."""
  cancelDeconstructEntities(input: DeconstructEntitiesInput!): DeconstructionResult!
  """Instantly mines one selected resource, tree, or rock using the engine's player mining operation."""
  mine(input: MineInput!): ActionResult!
  """Mines one entity so the actor recovers it and its contents; supports any minable entity."""
  remove(input: RemoveInput!): RemoveResult!
  """Mines up to 200 entities at explicit positions, continuing past failures."""
  removeMany(input: RemoveManyInput!): RemoveManyResult!
  """Moves a dropped item stack into the character's inventory, possibly partially."""
  pickup(input: PickupInput!): ActionResult!
  """Takes up to the requested number of normal-quality items from a transport belt into the acting character's inventory."""
  beltTake(input: BeltTakeInput!): ActionResult!
  """Rotates an entity by one to three clockwise quarter turns."""
  rotate(input: RotateInput!): ActionResult!
  """Transfers normal-quality items between the actor's main inventory and an entity inventory."""
  transfer(input: TransferInput!): ActionResult!
  """Moves normal-quality items between the actor's main inventory and a guns, ammo, armor, or trash slot."""
  equip(input: EquipInput!): ActionResult!
  """Changes an assembling machine's recipe after checking that it is idle and empty. Furnaces auto-select a recipe when an item is transferred into their input."""
  setRecipe(input: SetRecipeInput!): ActionResult!
  """Clears an assembling machine's recipe after checking that it is idle."""
  clearRecipe(input: ClearRecipeInput!): ActionResult!
  """Starts research of an enabled, unresearched technology whose prerequisites are researched."""
  startResearch(input: StartResearchInput!): ResearchState!
  """Stops the force's current research and returns the resulting state; dependent queued technologies are removed."""
  cancelResearch(input: CancelResearchInput!): ResearchState!
  """Prints a free-form message to all connected players in chat; use it to share plans or thoughts."""
  announce(message: String!): AnnounceResult!
  """Requests a server save over RCON."""
  save: ServerResult!
  """Requests server shutdown over RCON."""
  shutdown: ServerResult!
}
"""Search around a finite position on a nonempty surface. Radius must be greater than 0 and at most 100; limit is 1 through 1000 and offset is zero-based."""
input NearbyInput {
  surface: String = "nauvis"
  position: PositionInput = {x: 0, y: 0}
  radius: FiniteFloat = 10
  name: String
  type: String
  order: NearbyOrder = DISTANCE
  offset: Int = 0
  limit: Int = 100
}
enum NearbyOrder { DISTANCE UNIT_NUMBER }
"""Select one actor and a nonempty recipe name."""
input RecipeInput { actor: ActorInput! recipe: String! }
"""Inspect one entity using the selected actor's force."""
input InspectInput {
  actor: ActorInput!
  target: EntityRefInput!
}
"""Player must be disconnected and have an empty crafting queue and a main inventory."""
input CharacterCreateInput {
  player: String!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Player must be disconnected. Player and detached character must have empty crafting queues and matching forces; the character's non-main inventories must be empty."""
input CharacterReturnInput {
  player: String!
  character: UnitNumber!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Surface must exist and force must name an existing force. Position is the preferred spawn point; the engine selects the closest non-colliding point within 10 tiles."""
input CharacterSpawnInput {
  surface: String! = "nauvis"
  position: PositionInput!
  force: String = "player"
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Player must be connected and must control no character."""
input PlayerRestoreInput {
  player: String!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Surface must exist. Limits are 1 to 1000; offsets are non-negative. Detached-only selects characters without a controlling player."""
input CharactersInput {
  surface: String! = "nauvis"
  detachedOnly: Boolean = true
  limit: Int! = 100
  offset: Int! = 0
}
"""Place one entity with a canonical engine direction from 0 through 15."""
input PlaceInput {
  actor: ActorInput!
  surface: String = "nauvis"
  position: PositionInput!
  item: String!
  direction: Int! = 0
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  """Replace a fast-replaceable entity at the target instead of failing on the collision."""
  fastReplace: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""One placement position with canonical engine direction from 0 through 15."""
input PlacementInput {
  position: PositionInput!
  direction: Int! = 0
  fastReplace: Boolean = false
}
"""Place the same item at up to 1000 finite positions, continuing past per-entry failures."""
input PlaceManyInput {
  actor: ActorInput!
  surface: String = "nauvis"
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  placements: [PlacementInput!]!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Place one tile item at a finite whole-tile position."""
input PlaceTileInput {
  actor: ActorInput!
  surface: String = "nauvis"
  position: PositionInput!
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Area limits are positive and at most 256 tiles per side. Modules and fuel default on; tiles, trains, and station names default off."""
input CreateBlueprintInput {
  surface: String = "nauvis"
  force: String = "player"
  area: FactoryAreaInput!
  includeTiles: Boolean! = false
  includeModules: Boolean! = true
  includeFuel: Boolean! = false
  includeTrains: Boolean! = false
  includeStationNames: Boolean! = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Imports a blueprint string and places entity ghosts using one canonical engine direction."""
input PlaceBlueprintInput {
  surface: String = "nauvis"
  force: String = "player"
  blueprint: String!
  position: PositionInput!
  direction: Int! = 0
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""One blueprint-relative entity. At most 1000 entities; direction is 0 through 15."""
input BlueprintEntityInput {
  name: String!
  position: PositionInput!
  direction: Int! = 0
  quality: String
  recipe: String
  recipeQuality: String
  mirror: Boolean
}
"""One blueprint-relative tile. At most 2000 tiles; positions are integer tile coordinates."""
input BlueprintTileInput { name: String! x: Int! y: Int! }
"""Explicit entities and tiles for createBlueprintFromEntities; at least one entry is required."""
input CreateBlueprintFromEntitiesInput {
  entities: [BlueprintEntityInput!]!
  tiles: [BlueprintTileInput!]! = []
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Fuel one entity as the selected actor."""
input FuelInput {
  actor: ActorInput!
  target: EntityRefInput!
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  count: Float = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Queue enabled recipe crafts for one actor."""
input CraftInput {
  actor: ActorInput!
  recipe: String!
  count: Float = 1
  wait: Boolean! = false
  waitTimeoutSeconds: Int! = 60
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Cancel crafts at a one-based queue index."""
input CancelCraftInput {
  actor: ActorInput!
  index: Int! = 1
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Mine one entity as the selected actor."""
input MineInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Mine one entity and recover its contents."""
input RemoveInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Mine up to 200 entities, continuing past per-entry failures."""
input RemoveManyInput {
  actor: ActorInput!
  targets: [EntityRefInput!]!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Pick up one dropped stack at a finite position."""
input PickupInput {
  actor: ActorInput!
  position: PositionInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Take items from one transport belt."""
input BeltTakeInput {
  actor: ActorInput!
  target: EntityRefInput!
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  count: Float = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Rotate one entity by one to three clockwise quarter turns."""
input RotateInput {
  actor: ActorInput!
  target: EntityRefInput!
  turns: Int = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Move items between actor main inventory and one entity."""
input TransferInput {
  actor: ActorInput!
  target: EntityRefInput!
  inventory: InventoryKind!
  direction: TransferDirection!
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  count: Float!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Move items between actor main inventory and an equipment inventory."""
input EquipInput {
  actor: ActorInput!
  item: String!
  """Item quality prototype name; defaults to normal."""
  quality: String = "normal"
  count: Float = 1
  inventory: String!
  direction: EquipmentTransferDirection!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Change one machine's recipe."""
input SetRecipeInput {
  actor: ActorInput!
  target: EntityRefInput!
  recipe: String!
  """Selected recipe quality prototype name; defaults to normal."""
  recipeQuality: String
  drain: RecipeDrainMode = ABORT
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
enum ProductionWindow { ONE_MINUTE TEN_MINUTES ONE_HOUR }
input FactoryOverviewInput { surface: String! = "nauvis" force: String! = "player" window: ProductionWindow! = ONE_MINUTE }
input FactoryAreaInput { leftTopX: FiniteFloat! leftTopY: FiniteFloat! rightBottomX: FiniteFloat! rightBottomY: FiniteFloat! }
"""Clearing is limited to areas with positive dimensions no greater than 256 tiles per side."""
input ClearAreaInput {
  surface: String! = "nauvis"
  area: FactoryAreaInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Mine trees and rocks as one actor."""
input HarvestAreaInput {
  actor: ActorInput!
  area: FactoryAreaInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Pick up dropped stacks as one actor."""
input PickupAreaInput {
  actor: ActorInput!
  area: FactoryAreaInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Place or cancel deconstruction orders in a bounded area."""
input DeconstructAreaInput {
  """Optional actor; instant mode mines targets as this actor instead of destroying them. With reach enforcement enabled, unreachable targets are destroyed instead."""
  actor: ActorInput
  surface: String! = "nauvis"
  force: String = "player"
  area: FactoryAreaInput!
  names: [String!]
  types: [String!]
  instant: Boolean = false
  limit: Int = 500
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Place or cancel deconstruction orders for up to 200 explicit targets."""
input DeconstructEntitiesInput {
  force: String = "player"
  targets: [EntityRefInput!]!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Deconstruction work plus typed per-target failures."""
type DeconstructionResult { tick: Float! surface: String! force: String! orders: Int! skipped: Int! removed: Int! items: [InventoryStack!]! errors: [BatchError!]! }
input MachinesInput { surface: String! = "nauvis" force: String! = "player" status: String type: String area: FactoryAreaInput limit: Int! = 100 offset: Int! = 0 }
type ProductionItem { item: String! produced: Float! consumed: Float! producedPerMinute: Float! consumedPerMinute: Float! }
type FactoryProduction { tick: Float! surface: String! force: String! window: ProductionWindow! items: [ProductionItem!]! }
type MachineSummary { type: String! total: Int! working: Int! idle: Int! noFuel: Int! "Machines reporting no_power, low_power, or not_connected_to_electric_network. Machine scans cover assembling machines, furnaces, mining drills, labs, and rocket silos; inserter power faults are visible through powerConsumers." noPower: Int! noIngredients: Int! outputFull: Int! other: Int! }
type FactoryMachine { name: String! type: String! position: Position! status: String! fuel: [InventoryStack!]! }
type MachinePage { tick: Float! surface: String! force: String! pageInfo: PageInfo! machines: [FactoryMachine!]! summaries: [MachineSummary!]! }
"""Area limits are positive and at most 256 tiles per side. Limits are 1 to 1000; offsets are non-negative."""
input EntitiesInput { surface: String! = "nauvis" area: FactoryAreaInput! name: String type: String limit: Int! = 100 offset: Int! = 0 }
type EntityPage { tick: Float! surface: String! pageInfo: PageInfo! entities: [Entity!]! }
input BeltsInput { surface: String! = "nauvis" area: FactoryAreaInput! limit: Int! = 100 offset: Int! = 0 }
type BeltLine { items: [InventoryStack!]! }
type BeltInfo { position: Position! direction: Int unitNumber: UnitNumber line1: BeltLine! line2: BeltLine! }
type BeltPage { tick: Float! surface: String! pageInfo: PageInfo! belts: [BeltInfo!]! }
type CharacterInfo { unitNumber: UnitNumber! position: Position! surface: String! force: String! health: Float player: String }
type CharacterPage { tick: Float! surface: String! pageInfo: PageInfo! characters: [CharacterInfo!]! }
type FactoryOverview { productionTick: Float! machineTick: Float! surface: String! force: String! window: ProductionWindow! production: [ProductionItem!]! machines: [MachineSummary!]! }
type Position { x: Float! y: Float! }
type ConnectedPlayer { name: String! surface: String! position: Position! actor: Actor! @goField(forceResolver: true) }
type Status { tick: Float! players: [ConnectedPlayer!]! }
type Nearby { tick: Float! surface: String! pageInfo: PageInfo! entities: [Entity!]! }
type Entity { tick: Float force: String name: String! type: String position: Position surface: String direction: Int unitNumber: UnitNumber amount: Float distance: Float inspection(actor: ActorInput!): EntityInspection @goField(forceResolver: true) }
type EntitySnapshot { tick: Float! surface: String! force: String! entity: Entity! }
"""Actor resolved for an actor-scoped operation. Input selector is preserved."""
type ActorIdentity { player: String character: UnitNumber }
type Actor { tick: Float! player: String character: UnitNumber force: String! surface: String! position: Position hasCharacter: Boolean health: Float connected: Boolean controllerType: Int inventory: ActorInventory! @goField(forceResolver: true) queue: CraftQueue! @goField(forceResolver: true) recipe(name: String!): Recipe! @goField(forceResolver: true) nearby(radius: FiniteFloat = 10, name: String, type: String, order: NearbyOrder = DISTANCE, offset: Int = 0, limit: Int = 100): Nearby! @goField(forceResolver: true) }
"""Aggregated fluid amount in an inspected entity."""
type FluidContent { name: String! amount: Float! }
type ActorInventory { tick: Float! surface: String! force: String! player: String character: UnitNumber inventory: String items: [InventoryStack!]! itemEntries: Int }
type QueueEntry { recipe: String count: Float recipeInfo(actor: ActorInput!): Recipe @goField(forceResolver: true) }
type CraftQueue { tick: Float! surface: String! force: String! actor: ActorIdentity! player: String character: UnitNumber queue: [QueueEntry!]! queueEntries: Int queueSize: Float progress: Float }
type Recipe { tick: Float! player: String character: UnitNumber force: String! name: String enabled: Boolean category: String energy: Float ingredients: [RecipeIngredient!]! products: [RecipeProduct!]! hiddenFromPlayerCrafting: Boolean craftableCount: Float }
type Inventories { input: [InventoryStack!] output: [InventoryStack!] fuel: [InventoryStack!] chest: [InventoryStack!] modules: [InventoryStack!] turretAmmo: [InventoryStack!] main: [InventoryStack!] guns: [InventoryStack!] ammo: [InventoryStack!] armor: [InventoryStack!] trash: [InventoryStack!] roboportRobot: [InventoryStack!] roboportMaterial: [InventoryStack!] cargoWagon: [InventoryStack!] carTrunk: [InventoryStack!] spiderTrunk: [InventoryStack!] artilleryWagonAmmo: [InventoryStack!] }
type ProductionCount { name: String! count: Float! }
type ProductionStatistics { produced: [ProductionCount!]! consumed: [ProductionCount!]! }
type TransportLine { items: [InventoryStack!]! }
type EntityInspection { tick: Float! name: String type: String position: Position surface: String! force: String! health: Float maxHealth: Float inventories: Inventories fluids: [FluidContent!]! status: Int statusName: String recipe: String craftingProgress: Float transportLines: [TransportLine!] pickupPosition: Position dropPosition: Position heldStack: InventoryStack miningProgress: Float miningTarget: Entity miningResources: [Entity!] forceItemProduction: ProductionStatistics toBeDeconstructed: Boolean! recipeInfo(actor: ActorInput!): Recipe @goField(forceResolver: true) logistics: InspectionLogistics! @goField(forceResolver: true) }
type ActionResult { actor: ActorIdentity! character: UnitNumber player: String tick: Float! position: Position surface: String! force: String! name: String entity: String item: String quality: String recipe: String direction: Int transferDirection: TransferDirection equipmentDirection: EquipmentTransferDirection before: Int turns: Int count: Float requested: Float started: Float queueSize: Float moved: Float remaining: Float available: Float capacity: Float inventory: String returned: [InventoryStack!] items: [InventoryStack!] unitNumber: UnitNumber inserted: Float transferredStacks: Int returnedStacks: Int craftingComplete: Boolean waitTimedOut: Boolean waitedSeconds: Float instant: Boolean mined: Boolean }
"""Batch placement counts and typed per-position failures."""
type PlaceManyResult { tick: Float! surface: String! force: String! actor: ActorIdentity! item: String! placed: Int! failed: Int! errors: [BatchError!]! entities: [PlacedEntity!]! }
"""One entity reference used by placement and action results."""
type PlacedEntity { name: String! type: String position: Position unitNumber: UnitNumber }
"""Entity inventory key for transfer."""
enum InventoryKind { INPUT OUTPUT FUEL CHEST MODULES TURRET_AMMO ROBO_PORT_ROBOT ROBO_PORT_MATERIAL CARGO_WAGON CAR_TRUNK SPIDER_TRUNK ARTILLERY_WAGON_AMMO }
"""How setRecipe handles a machine that still holds items or fluid."""
enum RecipeDrainMode { ABORT TO_ACTOR SPILL }
"""Tile placed by placeTile."""
type PlaceTileResult { tick: Float! surface: String! force: String! actor: ActorIdentity! tile: String! position: Position! }
"""Blueprint string created by createBlueprint."""
type BlueprintResult { tick: Float! surface: String! force: String! entityCount: Int! blueprint: String! }
"""Blueprint string created from explicit entities and tiles."""
type BlueprintFromEntitiesResult { tick: Float! entityCount: Int! tileCount: Int! blueprint: String! }
"""Entity ghost placed by placeBlueprint."""
type BlueprintPlacedEntity { name: String! type: String! position: Position! unitNumber: UnitNumber }
"""Ghosts placed by placeBlueprint."""
type BlueprintPlaceResult { tick: Float! surface: String! force: String! ghosts: Int! entities: [BlueprintPlacedEntity!]! }
type ClearAreaResult { tick: Float! surface: String! treesRemoved: Int! rocksRemoved: Int! }
type HarvestAreaResult { tick: Float! surface: String! force: String! actor: ActorIdentity! treesMined: Int! rocksMined: Int! outOfReach: Int! failed: Int! errors: [BatchError!]! items: [InventoryStack!]! }
type PickupAreaResult { tick: Float! surface: String! force: String! actor: ActorIdentity! stacksFound: Int! stacksOutOfReach: Int! errors: [BatchError!]! itemsPickedUp: [InventoryStack!]! itemsRemaining: [InventoryStack!]! }
"""Mined entity and stacks added to actor main inventory."""
type RemoveResult { tick: Float! surface: String! force: String! actor: ActorIdentity! entity: String! type: String position: Position items: [InventoryStack!]! }
"""Bulk removal counts with typed per-target failures."""
type RemoveManyResult { tick: Float! surface: String! force: String! actor: ActorIdentity! removed: Int! failed: Int! errors: [BatchError!]! }
type ServerResult { response: String! }
type AnnounceResult { tick: Float! message: String! }
"""Force and technology to start researching. Force defaults to player."""
input StartResearchInput {
  force: String = "player"
  technology: String!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Force whose current research is stopped. Force defaults to player."""
input CancelResearchInput {
  force: String = "player"
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
"""Force research state after a start request."""
type ResearchState { tick: Float! force: String! technology: String! started: Boolean! currentResearch: String researchQueue: [String!]! }
"""Clear one machine's recipe."""
input ClearRecipeInput {
  actor: ActorInput!
  target: EntityRefInput!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
