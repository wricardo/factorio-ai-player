extend type Query {
  """Find the legal placement of one prototype nearest to an origin, without building anything. Candidates are tile-aligned centers for the prototype's footprint (odd sizes on half tiles, even sizes on whole tiles, width and height swapped for east and west directions) inside maxRadius (greater than 0, at most 512 tiles), evaluated in order of distance from origin with ties broken by x then y, and the first candidate that passes every check wins. Every candidate is tested with the engine's manual build check, the same rules a player placing by hand gets, so offshore pumps need water and pumpjacks need an oil field instead of passing on bare ground. Checks run cheapest first and short-circuit: engine placement, resource overlap, water, nearby entities, power coverage, water adjacency, then the required resource inside the drill's mining area. blockers, terrain and tile only describe why the snapped origin itself is refused by the engine and stay empty when the engine accepts it, so a candidate rejected by a caller constraint reports no blockers. expanded counts every candidate evaluated including the winner, and found false with null position and distance means the search was exhausted. resourceTiles and resourceAmount report the required resource found inside the mining area of the winning candidate and are 0 when requireResource is not set. This is an engine placement check only: it ignores reach, inventory and research, so a found placement still needs a real placement call. Invalid surface, force, prototype, direction, maxRadius, minDistanceFromEntities, minResourceTiles, a missing origin, or minResourceTiles without requireResource fails the query."""
  nearestPlacement(input: NearestPlacementInput!): PlacementCandidate!
}

"""Surface, force and prototype must exist. direction is 0 through 15. maxRadius is greater than 0 and at most 512 tiles, measured from origin to the candidate center. minDistanceFromEntities is 0 through 64 tiles of clear space between the footprint and any built entity or ghost of any force; natural entities (resources, trees, rocks, cliffs), characters, corpses and items never count."""
input NearestPlacementInput {
  surface: String! = "nauvis"
  force: String! = "player"
  prototype: String!
  direction: Int! = 0
  origin: PositionInput!
  maxRadius: FiniteFloat! = 16
  """Reject footprints that overlap a resource entity."""
  avoidResources: Boolean! = false
  """Reject footprints that overlap a water tile."""
  avoidWater: Boolean! = false
  minDistanceFromEntities: FiniteFloat
  """Require the footprint to touch the supply area of an electric pole of the force."""
  requirePowerCoverage: Boolean! = false
  """Require a water tile within one tile of the footprint."""
  requireWaterAdjacency: Boolean! = false
  """Require this resource prototype inside the prototype's mining area; needs a mining drill prototype that exposes mining_drill_radius."""
  requireResource: String
  """Minimum number of resource entities that must sit inside the mining area; omitted or 0 means 1, at most 100000, and only valid together with requireResource."""
  minResourceTiles: Int
}

type PlacementCandidate {
  tick: Float!
  surface: String!
  force: String!
  prototype: String!
  direction: Int!
  found: Boolean!
  """Center of the nearest legal placement; null when none was found."""
  position: Position
  """Euclidean distance from origin to position; null when none was found."""
  distance: Float
  """Prototype names colliding with the snapped origin, sorted; empty when the engine accepts the origin."""
  blockers: [String!]!
  """True when the ground tile under the snapped origin itself blocks the prototype."""
  terrain: Boolean!
  """Ground tile name under the snapped origin."""
  tile: String!
  """Candidates evaluated, including the winner."""
  expanded: Int!
  """Resource entities of requireResource inside the winning candidate's mining area; 0 when no resource was required."""
  resourceTiles: Int!
  """Total amount of requireResource inside the winning candidate's mining area; 0 when no resource was required."""
  resourceAmount: Float!
}
