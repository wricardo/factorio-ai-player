extend type Query {
  """
  Current-research nominal science demand and observed stock for one force on one surface, read as a single-tick snapshot.
  progress and researchUnits come from the engine, while nominalPacksLeft is the ceiling of remaining research units
  times the per-unit ingredient amount, ignoring productivity, lab drain and quality or durability bonuses, so it is a
  baseline rather than predicted consumption or a production-rate estimate. Stock counts container, logistic-container
  and infinity-container contents plus lab inputs and character main inventories of that force on that surface across
  all qualities; belts, ground items, cargo, inaccessible inventories and transit are excluded, so availableItems is
  not factory-wide supply. missingPackLabCount and the per-pack lab counts scan every lab of the force on the whole
  surface and flag labs missing a required pack or whose prototype cannot accept it; for trigger research sciencePacks
  is empty and the science-unit fields are zero. With no active research technology and progress are null and
  sciencePacks is empty. Empty or unknown force/surface names produce a GraphQL error.
  """
  scienceBudget(force: String! = "player", surface: String! = "nauvis"): ScienceBudget!
  """
  Ghosts of the selected force (entity-ghost, tile-ghost and item-request-proxy) inside an optional finite area of at
  most 1024 tiles per side, sorted by entity id and paginated with limit 1..10000 and a zero-based offset; pageInfo.total
  counts all matches in that scope. Omit area to scan the whole surface, matching entities, entityCount and
  factoryAlerts; a supplied area keeps the 1024-tile cap. Material availability is a separate scan of container,
  logistic-container and infinity-container chest contents plus character main inventories of that force in the same
  scope — belts, ground items, logistic networks and reach are not consulted, so buildable only means observed local
  stock covers one placement alternative plus every item_request. Entity and tile ghosts list each items_to_place_this
  entry as an alternative, not an additive requirement, while requestedMaterials (including modules and qualities) is
  additive; item-request proxies are buildable purely from their requests and take name/quality from a valid
  proxy_target. Availability is computed per entry with no reservation or sharing, so the same stock may satisfy several
  entries and a buildable backlog for the scope as a whole is not implied. Placement is checked separately: every entity
  ghost is probed with the engine's own manual placement check and reports blocked plus the prototype of one colliding
  entity, so a plan held up by a rock, tree or machine is visible instead of looking ready. Out-of-range area dimensions,
  invalid limit/offset or unknown surface/force name produce a GraphQL error; an empty ghostEntries list means no ghosts
  matched.
  """
  ghosts(input: GhostsInput!): GhostsPage!
}

extend type EntityInspection {
  """Required current-research ingredients absent or below one research unit in this lab. Empty for non-labs or no active science research. Separate snapshot."""
  missingSciencePacks: [MissingSciencePack!]! @goField(forceResolver: true)
  """Engine fluidbox connectivity, without implicit links between different boxes on a machine or pump. Separate snapshot."""
  fluidNetwork(maxBoxes: Int! = 1000): FluidNetwork! @goField(forceResolver: true)
}

type ScienceBudget {
  tick: Float!
  force: String!
  surface: String!
  technology: String
  """Null without active research."""
  progress: Float
  researchUnits: Float
  remainingResearchUnits: Float
  """True for research driven by a trigger rather than lab science."""
  triggerResearch: Boolean!
  labCount: Int!
  """Labs missing at least one required pack or unable to accept it."""
  missingPackLabCount: Int!
  """Stock scope: container/logistic-container/infinity-container, lab inputs and character main inventories on this force/surface; excludes belts, ground items, cargo, inaccessible inventories and transit. Counts actual items, not durability or quality-adjusted research value."""
  sciencePacks: [SciencePackBudget!]!
}

type SciencePackBudget {
  name: String!
  perResearchUnit: Int!
  """Ceiling of remainingResearchUnits times ingredient amount. Nominal baseline, not exact future consumption: ignores productivity, lab drain and quality/durability bonuses."""
  nominalPacksLeft: Float!
  availableItems: Float!
  nominalShortfall: Float!
  missingLabCount: Int!
  unsupportedLabCount: Int!
}

type MissingSciencePack {
  name: String!
  required: Int!
  available: Float!
  missing: Float!
  """False means this lab prototype cannot accept this research ingredient."""
  supported: Boolean!
}

input GhostsInput {
  surface: String! = "nauvis"
  force: String! = "player"
  """Optional finite positive dimensions, at most 1024 tiles per side. Omit to scan the whole surface."""
  area: FactoryAreaInput
  limit: Int! = 100
  offset: Int! = 0
}

type GhostsPage {
  tick: Float!
  surface: String!
  force: String!
  """Bounds that scoped this read; null when area was omitted and the whole surface was scanned."""
  area: WorldArea
  pageInfo: PageInfo!
  """Independent per-entry availability. Same stock can satisfy multiple entries; no reservations or promise that whole backlog can be built."""
  ghostEntries: [GhostBacklogEntry!]!
}

type GhostBacklogEntry {
  id: ID!
  unitNumber: UnitNumber
  kind: String!
  name: String!
  quality: String!
  position: Position!
  """Alternative items_to_place_this entries, not additive requirements. Counts come from prototype, quality from ghost. First alternative is construction robots' normal choice."""
  placementAlternatives: [GhostMaterial!]!
  """Engine item_requests for ghost/proxy, including requested modules and quality; additive requirements."""
  requestedMaterials: [GhostMaterial!]!
  """Materials for one placement alternative plus all requests available in observed area stock. False without a placement alternative except for item-request proxies. Material availability only: placement collisions are reported by blocked, and robot coverage, research, reach and delivery are still not asserted."""
  buildable: Boolean!
  """Engine placement check for this ghost's own tile: true when a real entity (rock, tree, machine) or an unpaved tile would refuse the build, so no amount of stock and no robot can place it. Independent of buildable; item-request proxies and tile ghosts are never reported blocked because the engine check only covers entity ghosts."""
  blocked: Boolean!
  """Prototype name of one blocking entity found inside the ghost's footprint, when blocked by an entity; null when unblocked, when the blocker is a tile, or when no single entity could be named."""
  blockingName: String
}

type GhostMaterial {
  name: String!
  quality: String!
  count: Float!
  available: Float!
  missing: Float!
}

type FluidNetwork {
  tick: Float!
  surface: String!
  """Hard bound on visited fluidbox nodes, from 1 to 50000."""
  maxBoxes: Int!
  visitedBoxes: Int!
  truncated: Boolean!
  """All seed fluidboxes of inspected entity; separate boxes are never joined merely because they share an owner. Pumps thus remain boundaries between input/output segments."""
  rootBoxIds: [ID!]!
  fluidEntities: [FluidNetworkEntity!]!
  fluidBoxes: [FluidNetworkBox!]!
  fluidConnections: [FluidNetworkConnection!]!
  """Unique engine fluid segments, or individual non-segment boxes. Each counted once even when several listed boxes share it. Segment totals include full storage of that segment, even if node traversal is truncated."""
  fluidSegments: [FluidNetworkSegment!]!
  totalAmount: Float!
  totalCapacity: Float!
}

type FluidNetworkEntity { id: ID! unitNumber: UnitNumber name: String! type: String! surface: String! force: String! position: Position! inspection: EntityInspection @goField(forceResolver: true) }
type FluidNetworkBox { id: ID! entityId: ID! index: Int! segmentId: ID! }
type FluidNetworkConnection { fromBoxId: ID! toBoxId: ID! flowDirection: String! connectionType: String! }
type FluidNetworkSegment {
  id: ID!
  engineSegmentId: ID
  capacity: Float!
  segmentFluids: [FluidNetworkAmount!]!
  """Highest temperature among visited member boxes of this segment; null when the segment holds no fluid or no member box was visited."""
  temperature: Float
  """Visited boxes belonging to this segment. The traversal may not reach every box of the engine segment, so this is the observed membership, not the full segment."""
  members: [FluidBoxMember!]!
}
type FluidNetworkAmount { name: String! amount: Float! }