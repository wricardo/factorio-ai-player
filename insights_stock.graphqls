extend type Query {
  """
  Observed item quantities in a single-tick snapshot, grouped by inventory or belt line, item and quality, with three
  independent pages: locations (one row per inventory/belt line and item), totals (per item, quality and category) and
  items (per item and quality summed across every category), each with its own limit 1..1000 and zero-based offset.
  Totals and items cover the complete filtered scope regardless of the location page, while locations are sorted by
  category, position, entity type and name, player, inventory kind and item. Scope covers selected-force player main
  inventories, ordinary/logistic/infinity chest contents, crafting machine, furnace, silo, lab, drill, agricultural
  tower and asteroid collector inventories, fuel and burnt-result inventories, inserter hands, belt and loader
  transport lines and ground item stacks; linked containers, vehicles, wagons, robots, roboports, turrets, cargo hubs,
  player equipment and trash, and all fluids are excluded, so totals are not global factory stock. Ground stacks have
  no force ownership and are included regardless of the selected force, while every other source must match the
  selected force and surface; area filters entity and player positions, not individual items along a belt. All
  transport lines of each belt are counted, a line object one entity exposes twice is deduplicated by line_equals, and
  contents are read per entity tile, so a long belt contributes every item actually sitting on it. Exceeding one
  million line comparisons fails the whole query instead of returning partial totals, and an empty item value, invalid
  category, unknown surface/force, non-finite or inverted area, or out-of-range pagination are GraphQL errors.
  """
  stock(input: StockInput = {}): StockPage!
}

input StockInput {
  """Surface and force must be non-empty names of existing objects."""
  surface: String! = "nauvis"
  force: String! = "player"
  """Optional finite bounds; left/top must not exceed right/bottom. Omit to scan the surface."""
  area: FactoryAreaInput
  """Exact non-empty item name, if supplied."""
  item: String
  """Exact stock category; omit to include every category."""
  category: StockCategory
  """Location page size from 1 through 1000."""
  limit: Int! = 100
  """Zero-based, non-negative location offset."""
  offset: Int! = 0
  """Totals page size from 1 through 1000, independent of locations."""
  totalsLimit: Int! = 100
  """Zero-based, non-negative totals offset."""
  totalsOffset: Int! = 0
  """Items page size from 1 through 1000, independent of the other pages."""
  itemsLimit: Int! = 100
  """Zero-based, non-negative items offset."""
  itemsOffset: Int! = 0
}

"""Stock location category. STORED is an entity inventory, IN_TRANSIT is a belt or inserter hand, GROUND is a dropped stack, PLAYER is a connected player's inventory."""
enum StockCategory {
  STORED
  IN_TRANSIT
  GROUND
  PLAYER
}

type StockPage {
  tick: Float!
  surface: String!
  force: String!
  locationPageInfo: PageInfo!
  locations: [StockLocation!]!
  totalPageInfo: PageInfo!
  totals: [StockTotal!]!
  itemPageInfo: PageInfo!
  """One row per item and quality, summed across every category in the active filter."""
  items: [StockItemTotal!]!
}

type StockLocation {
  """stored, in-transit, ground, or player."""
  category: String!
  entityName: String!
  entityType: String!
  player: String
  position: Position!
  """Inventory kind, or line-N for a transport line; shared lines are counted once."""
  inventoryKind: String!
  stack: StockStack!
}

type StockStack { name: String! quality: String! count: Float! }
type StockTotal { item: String! quality: String! category: String! count: Float! }
"""Item and quality quantity summed across every stock category. Not a global factory total: the inventory scope is the one in the stock description."""
type StockItemTotal { item: String! quality: String! count: Float! }
