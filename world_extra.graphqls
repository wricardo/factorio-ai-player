extend type Query {
  """Lists every surface in the running game with its name, index, planet name, total pollution, and the named force's evolution factor on that surface. force is required and must exist; an unreadable evolution value degrades to 0 and a surface that does not expose a planet reports null. Results are sorted by surface index on the Go side, so repeated calls compare positionally, and the page carries the observation tick. This is surface metadata only, not per-surface production or entity counts."""
  surfaces(force: String! = "player"): SurfacePage!
  """Reads the signals currently visible on one entity's red (the default) or green circuit network, together with that entity's red and green connection counts. The target is located by unitNumber, or by prototype name plus an exact centre-position match (within 0.001 tiles), on its own surface field (default nauvis); no actor or reach check is involved, and an entity resolvable only by unit-number scan needs its prototype name supplied. connected is false when the entity exposes no network of the requested colour, in which case signals is empty while both connection counts are still reported; ambiguous centre matches and unknown entities are GraphQL errors. Signals are sorted by type, name, quality (unqualified first), and value, and quality is null for virtual and fluid signals. One unpaginated snapshot at the reported tick, so a large network returns every signal in a single response."""
  circuitNetwork(input: CircuitNetworkInput!): CircuitNetworkSignals!
  """Lists the named force's custom map chart tags on one surface, ordered by tag number, optionally restricted to an area that must have finite coordinates and positive dimensions. surface and force must be non-empty and exist; limit is 1..10000 and offset is zero-based, with pageInfo reporting the total and hasMore for the filtered set. Each tag carries its force-unique tagNumber, position, text (empty when unset), and icon when one was set. One snapshot at the reported tick, with no actor or reach check."""
  chartTags(input: ChartTagsInput!): ChartTagPage!
  """Lists the circuit networks reachable from the entities inside an area, grouped by the engine's network id, in one Lua chunk. surface and force default to nauvis and player and must exist; area is required, limit (1..5000, default 500) caps how many entities are scanned and memberLimit (1..10000, default 100) caps the member connectors reported per network with truncated set when more exist. Entities are found on the given force only, and power (copper) connectors are ignored. Each network reports its networkId, wire color, the whole network's signals sorted by type, name, quality and value, and the member connectors with entity name, type, unit number, position and connector id. No actor or reach check applies."""
  circuitNetworks(input: CircuitNetworksInput!): CircuitNetworkPage!
}

extend type Mutation {
  """Adds one force-visible custom map marker at a finite map position on a surface. surface and force default to nauvis and player and must exist; at least one of nonblank text or icon (a signal reference) is required, and the engine assigns the force-unique tag number. Returns the created tag snapshot with its assigned tagNumber, position, text, and icon, at the post-write tick. Emits one in-game notification unless message overrides it. This writes the map marker itself, not entity or blueprint tags."""
  addChartTag(input: AddChartTagInput!): ChartTagMutationResult!
  """Removes one custom chart tag from a surface for a force, addressed by its force-unique tagNumber, which must parse as an unsigned 32-bit integer and must exist on that surface or the call fails. surface and force default to nauvis and player. Returns the final snapshot of the removed tag rather than the remaining page. Emits one in-game notification unless message overrides it."""
  removeChartTag(input: RemoveChartTagInput!): ChartTagMutationResult!
}

"""List custom chart tags, optionally restricted to an area. limit is 1 through 10000 and offset is zero-based."""
input ChartTagsInput {
  surface: String! = "nauvis"
  force: String! = "player"
  area: FactoryAreaInput
  offset: Int! = 0
  limit: Int! = 100
}

"""Add a custom chart tag. At least one of nonblank text or icon is required."""
input AddChartTagInput {
  surface: String! = "nauvis"
  force: String! = "player"
  position: PositionInput!
  text: String
  icon: SignalInput
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""Remove a custom chart tag by its force-unique tag number."""
input RemoveChartTagInput {
  surface: String! = "nauvis"
  force: String! = "player"
  tagNumber: ID!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""One force-visible custom marker in map view."""
type ChartTag {
  tagNumber: ID!
  position: Position!
  text: String!
  """Icon signal, using the shared SignalID shape; type is item when the engine stores none."""
  icon: SignalID
}

type ChartTagPage {
  tick: Float!
  surface: String!
  force: String!
  pageInfo: PageInfo!
  tags: [ChartTag!]!
}

"""Snapshot returned after adding or removing one chart tag."""
type ChartTagMutationResult {
  tick: Float!
  surface: String!
  force: String!
  tag: ChartTag!
}

type SurfaceInfo {
  name: String!
  index: Int!
  planet: String
  totalPollution: Float
  evolutionFactor: Float
}

type SurfacePage {
  tick: Float!
  force: String!
  surfaces: [SurfaceInfo!]!
}

"""Read one entity's red or green circuit network, optionally through a specific wire connector."""
input CircuitNetworkInput {
  target: EntityRefInput!
  color: WireColor! = RED
  """Engine wire connector id, for example circuit_red, circuit_green, combinator_output_red. Defaults to circuit_<color>, which on a combinator is the input connector; pass combinators' output connector to read the network the combinator drives."""
  connector: String
}

type CircuitNetworkSignals {
  tick: Float!
  surface: String!
  name: String
  unitNumber: UnitNumber
  color: WireColor!
  """Engine connector the network was read through."""
  connector: String!
  """True when the entity exposes a network through that connector."""
  connected: Boolean!
  """Engine network id; equal ids mean the same network. Null when not connected."""
  networkId: Int
  """Engine connected_circuit_count: how many circuits are attached to that network, not how many wires this entity has. Null when not connected."""
  networkCircuitCount: Int
  signals: [CircuitSignal!]!
}

"""List circuit networks in an area and the entities attached to them."""
input CircuitNetworksInput {
  surface: String! = "nauvis"
  force: String! = "player"
  area: FactoryAreaInput!
  """Maximum entities scanned, 1 through 50000."""
  limit: Int! = 500
  """Maximum members reported per network, 1 through 10000."""
  memberLimit: Int! = 100
}

type CircuitNetworkMember {
  name: String!
  """Entity type, for example arithmetic-combinator."""
  entityType: String!
  unitNumber: UnitNumber
  position: Position!
  """Engine wire connector the entity attaches to the network with."""
  connector: String!
}

"""One circuit network with its signals and member connectors. Signals cover the whole network, so a network extending past the queried area reports signals from outside it."""
type CircuitNetworkEntry {
  networkId: Int!
  color: WireColor
  signals: [CircuitSignal!]!
  members: [CircuitNetworkMember!]!
  """True when the network has more members than memberLimit."""
  truncated: Boolean!
}

type CircuitNetworkPage {
  tick: Float!
  surface: String!
  force: String!
  """Networks sorted by network id."""
  networks: [CircuitNetworkEntry!]!
  scannedEntities: Int!
}

"""One circuit signal; quality is null for virtual and fluid signals. type uses the same SignalType enum as SignalInput."""
type CircuitSignal {
  type: SignalType!
  name: String!
  quality: String
  value: Float!
}
