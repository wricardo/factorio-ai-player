extend type Status {
  """Current game simulation speed multiplier."""
  speed: Float!
  """True when the game tick is paused."""
  paused: Boolean!
}

extend type Mutation {
  """Sets the game simulation speed and pause state. A sandbox/administrative knob: it affects every player and every machine on the server."""
  setGameSpeed(input: GameSpeedInput!): GameSpeedResult!
  """Moves the acting character to finite coordinates on a surface. A sandbox convenience that bypasses travel; reach checks apply afterwards only when FACTORIO_ENFORCE_REACH=1."""
  teleport(input: TeleportInput!): ActionResult!
  """Uses a capsule item from the player's character inventory at a target position, for example a cliff explosive on a cliff. Player actor only."""
  useCapsule(input: CapsuleInput!): CapsuleResult!
  """Fires the player character's weapon at a target entity or position. Player actor only."""
  shoot(input: ShootInput!): ShootResult!
  """Repairs a damaged entity using repair packs from the acting character's main inventory."""
  repair(input: RepairInput!): RepairResult!
}

"""speed must be between 0.1 and 1000. paused omitted keeps the current pause state."""
input GameSpeedInput {
  speed: Float! = 1
  paused: Boolean
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type GameSpeedResult {
  tick: Float!
  speed: Float!
  paused: Boolean!
}

"""Move one selected actor to a finite position on a surface."""
input TeleportInput {
  actor: ActorInput!
  surface: String = "nauvis"
  position: PositionInput!
  snapToGrid: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""Selected actor must be a connected player controlling a character. count is 1 through 100."""
input CapsuleInput {
  actor: ActorInput!
  item: String!
  target: PositionInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type CapsuleResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  item: String!
  used: Int!
  position: Position!
  """Entities the engine created or damaged by the capsule action."""
  created: [PlacedEntity!]!
}

"""Selected actor must be a connected player. Target uses the shared entity reference; position-only targets are allowed."""
input ShootInput {
  actor: ActorInput!
  target: EntityRefInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type ShootResult {
  tick: Float!
  player: String!
  force: String!
  actor: ActorIdentity!
  character: UnitNumber
  ammoUsed: Int!
  target: PlacedEntity
  position: Position
}

"""Repair one entity as the selected actor. count is 1 through 100."""
input RepairInput {
  actor: ActorInput!
  target: EntityRefInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type RepairResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  name: String!
  unitNumber: UnitNumber
  position: Position!
  before: Float!
  after: Float!
  maxHealth: Float!
  packsUsed: Int!
}
