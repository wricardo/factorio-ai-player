extend type Status {
  """Current game simulation speed multiplier."""
  speed: Float!
  """True when the game tick is paused."""
  paused: Boolean!
}

extend type Mutation {
  """Sets the server-wide simulation speed and, when paused is given, the pause state, then returns the values read back in the same tick. speed must be finite and between 0.1 and 1000, validated in Go before the RCON call; omitting paused leaves the current pause state untouched instead of resuming. This is an administrative knob with no actor, surface or reach handling: it changes the tick rate for every force, machine and player on the server, so prefer a short pause over large multipliers while other work is in flight. The result reports the tick, the effective speed and paused after both writes, so a clamped or rejected engine state is visible rather than assumed. Success announces a generated summary unless message overrides it."""
  setGameSpeed(input: GameSpeedInput!): GameSpeedResult!
  """Moves the acting character to finite coordinates on an existing surface, bypassing travel, and returns the position the character ended up at in the same tick. Exactly one of a character unit number or a player name must be selected; surface defaults to nauvis and must exist, and a missing position or non-finite coordinate is rejected in Go before the RCON call. snapToGrid forwards the engine's tile-centre snapping flag, and the teleport is issued with the script-ghost build check type, so an engine rejection (false or raised error) fails the call instead of reporting a move. This call performs no reach check of its own: it only changes the reference point for later build and interaction mutations, which enforce reach only when FACTORIO_ENFORCE_REACH is on. Success returns the resulting surface, position and character identity, and announces a generated summary unless message overrides it."""
  teleport(input: TeleportInput!): ActionResult!
  """Uses a capsule item from a connected player's character main inventory at a finite target position, one capsule at a time up to count (1 through 100), and reports how many were consumed plus the entities the engine created or damaged. The actor must select a player rather than a detached character, that player must be connected and have a character, the item prototype must exist in the engine, and the target must lie within the character's reach distance when FACTORIO_ENFORCE_REACH is on. Actor selection, item name, count and finite target coordinates are rejected in Go before any RCON interaction; prototype, inventory and reach checks run in the engine call. Each use calls use_capsule on the found item stack, the loop stops early when the stack empties, and a use that both creates nothing and consumes nothing fails the call with an out-of-effect error. This is not transactional: capsules already consumed earlier in the same call stay consumed when a later use fails. The result reports used, item, surface, force, the target position and created entities, and success announces a generated summary unless message overrides it."""
  useCapsule(input: CapsuleInput!): CapsuleResult!
  """Fires the selected player character's weapon toward a target by starting a bounded shooting job in the navigation mod's factorio_ai_actions interface, polling it every 100 ms until it leaves SHOOTING, and then reporting the ammo actually spent. Only a player name with an existing character is accepted; count is the number of shooting ticks (1 through 100) the job keeps the fire control state set, with a wait ceiling of count/60 plus 10 seconds after which the job is cancelled and the call fails. The target is addressed by unitNumber, by entity name plus position, or by position alone: a name-plus-position lookup must match exactly one entity within 0.01 tiles of that centre, and a position-only shot plus any resolved entity must be on the character's own surface or the call fails. Ammo use is measured as the drop in the character ammo inventory between job start and completion, clamped at zero, so a job that ends non-COMPLETE is a GraphQL error rather than a zero report. A lost or failed response does not prove the job did not run; inspect the character's ammo and surroundings before retrying. Success returns the tick, player, character, target, aim position and ammoUsed, and announces a generated summary unless message overrides it."""
  shoot(input: ShootInput!): ShootResult!
  """Repairs one damaged entity by consuming normal-quality repair packs from the acting character's main inventory and raising health directly, because the engine's asynchronous repair_state action cannot run inside a single RCON call. count (1 through 100) caps how many packs may be spent: the call derives the packs needed from max health, current damage and the repair-pack durability prototype (300 when the prototype publishes none) and spends the smaller of that and count, so it fails when health is already full, the entity is destroyed, the entity publishes no usable health, or the inventory lacks the required packs. Packs are removed before health is written and are re-inserted when removal comes up short or the health assignment fails, so a failed call leaves the inventory as it was. The target is addressed by unitNumber or entity name plus position, reach is enforced only when FACTORIO_ENFORCE_REACH is on, and the result reports before, after, maxHealth and packsUsed from the same tick. Success announces a generated summary unless message overrides it."""
  repair(input: RepairInput!): RepairResult!
}

"""speed must be between 0.1 and 1000. paused omitted keeps the current pause state."""
input GameSpeedInput {
  speed: Float! = 1
  paused: Boolean
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type GameSpeedResult {
  tick: Float!
  speed: Float!
  paused: Boolean!
}

"""Move one selected actor to a finite position on a surface."""
input TeleportInput {
  actor: ActorInput!
  surface: String = "nauvis"
  position: PositionInput!
  snapToGrid: Boolean = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""Selected actor must be a connected player controlling a character. count is 1 through 100."""
input CapsuleInput {
  actor: ActorInput!
  item: String!
  target: PositionInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type CapsuleResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  item: String!
  used: Int!
  position: Position!
  """Entities the engine created or damaged by the capsule action."""
  created: [PlacedEntity!]!
}

"""Selected actor must be a connected player. Target uses the shared entity reference; position-only targets are allowed."""
input ShootInput {
  actor: ActorInput!
  target: EntityRefInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type ShootResult {
  tick: Float!
  player: String!
  force: String!
  actor: ActorIdentity!
  character: UnitNumber
  ammoUsed: Int!
  target: PlacedEntity
  position: Position
}

"""Repair one entity as the selected actor. count is 1 through 100."""
input RepairInput {
  actor: ActorInput!
  target: EntityRefInput!
  count: Int! = 1
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

type RepairResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  name: String!
  unitNumber: UnitNumber
  position: Position!
  before: Float!
  after: Float!
  maxHealth: Float!
  packsUsed: Int!
}
