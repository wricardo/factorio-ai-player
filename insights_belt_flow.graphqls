extend type Mutation {
  """Start non-invasive per-tick item-crossing measurement of exactly one normal transport-belt tile, addressed by unitNumber or the exact center position (a point on the belt tile; surface defaults to nauvis). The target must resolve to a single transport-belt: splitters, underground belts and loaders are rejected, and so is a belt whose belt_speed is at least half a lane per tick, because an item could then pass the midpoint between samples. Requires the factorio_ai_navigation mod exposing factorio_ai_belt_flow protocol 1 and Factorio >= 2.0.76 with the detailed transport-line item API; the returned measurement is a snapshot of the running job (status RUNNING) or its terminal COMPLETE/INVALIDATED state, and the belt's own force, surface, name, direction and position are recorded. At most 32 measurements may be active at once and a new job is rejected above that; durationTicks and waitTimeoutSeconds are validated before the measurement is started. With wait, the job is polled about every 250 ms up to waitTimeoutSeconds, and a timeout returns the latest RUNNING state without cancelling the measurement, which keeps sampling until durationTicks elapse. Does not change inventories, belt controls, or entities, and emits no chat notification."""
  beltThroughputStart(input: BeltThroughputStartInput!): BeltThroughputMeasurement!
}

extend type Query {
  """Read the current state of one retained belt measurement by its decimal ID (1 to 32 digits). RUNNING is live sampling, COMPLETE means durationTicks were sampled, and INVALIDATED means the belt was removed, replaced, rotated, relocated or changed force/surface, or its lane geometry changed, with the cause in reason. Finished records stay readable until the 128-record retention bound evicts the oldest finished job; an unknown or evicted ID returns no measurement, the mod reporting it as not found or evicted. Reading never cancels or advances a job, and elapsedTicks freezes at the last observed sample tick."""
  beltThroughput(id: ID!): BeltThroughputMeasurement!
}

input BeltThroughputStartInput {
  """Belt target by unit number or exact center position."""
  target: EntityRefInput!
  """Sampling duration in game ticks, from 1 to 36000. Pausing simulation pauses measurement."""
  durationTicks: Int! = 600
  """Wait for completion or invalidation, bounded by waitTimeoutSeconds. Timeout returns latest state without cancelling measurement."""
  wait: Boolean! = false
  """Wall-clock wait limit from 1 to 10 seconds; larger values are clamped to 10."""
  waitTimeoutSeconds: Int! = 10
}

"""Observed item crossings, not buffer-count deltas or theoretical capacity. Baseline snapshot at start is excluded; only IDs seen on both sides of each lane's fixed midpoint count. Items inserted downstream of that point do not count. Stack counts and quality are captured when crossing. Entity removal, replacement, rotation, relocation, or lane geometry changes invalidate the sample."""
type BeltThroughputMeasurement {
  """Game tick when this measurement state was observed."""
  tick: Float!
  id: ID!
  status: EngineStatus!
  reason: String
  surface: String!
  force: String!
  name: String!
  unitNumber: UnitNumber
  position: Position!
  startedTick: Float!
  updatedTick: Float!
  durationTicks: Int!
  elapsedTicks: Int!
  """Crossed items across both lanes, including stacked items."""
  itemsCrossed: Float!
  """Observed itemsCrossed * 3600 / elapsedTicks, including stalled ticks. Null until at least one sampled game tick."""
  itemsPerMinute: Float
  lanes: [BeltThroughputLane!]!
}

type BeltThroughputLane {
  """Factorio transport-line index, 1 or 2. No global left/right assumption at bends."""
  lane: Int!
  """Fixed transport-line midpoint in local line coordinates."""
  measurementPoint: Float!
  itemsCrossed: Float!
  itemsPerMinute: Float
  """Crossed item counts grouped by prototype and quality."""
  crossedItems: [BeltThroughputItem!]!
}

type BeltThroughputItem {
  name: String!
  quality: String!
  itemsCrossed: Float!
  itemsPerMinute: Float
}

extend type Mutation {
  """Walk one linear belt stretch from a seed belt (unitNumber or exact center position) and start non-invasive per-lane item-crossing measurement on one of its transport-belt tiles, so a snapshot mixture is checked over time: the stretch snapshot shows what sits on the lanes, the measurement shows what actually crosses them. sample picks the first, middle (default) or last transport-belt tile in travel order; stretches containing no normal transport-belt tile are rejected because splitters, underground belts and loaders cannot be measured. The stretch walk uses the same 1000-entity bound and stop rules as beltStretch, and the stretch snapshot and the measurement come from different RCON calls, so they can differ by a few ticks. Duration, wait, active-measurement and invalidation semantics are identical to beltThroughputStart, including the 250 ms poll and the no-cancel timeout."""
  beltStretchMeasure(input: BeltStretchMeasureInput!): BeltStretchMeasurement!
}

input BeltStretchMeasureInput {
  """Seed belt by unit number or exact center position."""
  target: EntityRefInput!
  """Sampling duration in game ticks, from 1 to 36000. Pausing simulation pauses measurement."""
  durationTicks: Int! = 600
  """Wait for completion or invalidation, bounded by waitTimeoutSeconds. Timeout returns latest state without cancelling measurement."""
  wait: Boolean! = false
  """Wall-clock wait limit from 1 to 10 seconds; larger values are clamped to 10."""
  waitTimeoutSeconds: Int! = 10
  """Which transport-belt tile of the stretch to measure: first, middle or last in travel order."""
  sample: BeltStretchSample! = MIDDLE
}

enum BeltStretchSample { FIRST MIDDLE LAST }

"""The stretch snapshot and the measurement started on one of its tiles. The measurement tile is the tile matching sample among the stretch's transport belts."""
type BeltStretchMeasurement {
  stretch: BeltStretch!
  measurement: BeltThroughputMeasurement!
}
