extend type Query {
  """Plan one connection run without changing the world. DIRECT routing (default) is one axis-aligned straight or single-bend run; ASTAR searches a bounded region for a shortest legal BELT or PIPE route around obstacles and, when allowed, under them with underground belts or pipe-to-ground. The route snaps both endpoints to tile centers and reports every step with the direction needed for that tile. A tile that already holds the requested entity with the required direction is marked existing and is not counted in needed. Conflicts are typed and explain why a step cannot be built, so a caller can move an endpoint instead of spending items on a partial run. Pipes are additionally checked for orthogonal neighbours that are not part of this run; joining a foreign fluid network is rejected unless allowFluidAdjacency is true. DIRECT plans surface tiles only: an obstruction is reported as a collision. ASTAR reports NO_PATH, EXPANSION_LIMIT or an endpoint collision with stopReason instead. Both endpoints must be finite; DIRECT rejects a route longer than 4096 tiles (|dx| + |dy| + 1) before running and reports at most 200 conflicts, while ASTAR rejects a padded search region above 65536 tiles. Nothing is placed and no item is consumed, so a plan can be re-run after moving an endpoint or raising the search limits."""
  connectionPlan(input: ConnectionPlanInput!): ConnectionPlan!
}

extend type Mutation {
  """Plan and then place one belt, pipe or power-pole run. The mutation requires the actor's character to be on the requested surface and force, and refuses to place anything when the plan has conflicts or the actor lacks the needed items, so a refusal leaves the world unchanged: a conflicted plan returns possible false with the typed conflicts and no placed tiles, while a missing-item shortfall fails the call as a GraphQL error before any tile is touched. Each existing tile is skipped and each placed tile consumes one normal-quality item from the actor's main inventory and raises a built event. Reach applies to every placed tile when reach enforcement is enabled; other per-tile failures (collision, inventory, engine rejection) are recorded in errors, capped at 20 entries, and the run continues so a call can end partially applied. The generated notification is printed only when at least one entity was placed, unless message overrides it. ASTAR plans first and then re-checks every tile while applying, so the applied run can still differ from the plan if the world changed between the two RCON reads."""
  connectEntities(input: ConnectEntitiesInput!): ConnectEntitiesResult!
  """Places a belt run (transport belts of any tier), equivalent to connectEntities with kind BELT and the same planner/applier, but with an input limited to belt fields. A single tile is from equal to to plus direction (0 north, 4 east, 8 south, 12 west); runs of two or more tiles take their directions from the route. Tunnelling needs routing ASTAR plus allowUnderground; the DIRECT default never tunnels. A refused run is a normal response, not an error: possible is false, stopReason and the typed conflicts name the blocking tile, placed and failed are 0 and errors is empty, so read possible before treating placed 0 as success."""
  placeBelts(input: BeltRunInput!): ConnectEntitiesResult!
  """Places one pipe run per call, equivalent to connectEntities with kind PIPE. Plan the route with connectionPlan first when it has to pass obstacles; that read reports FLUID_ADJACENCY and other conflicts before any item is spent. Use this instead of place/placeMany for pipes: it routes the run, can tunnel under crossings with pipe-to-ground, and refuses foreign fluid adjacency unless allowFluidAdjacency is true. Tunnelling only happens with routing ASTAR plus allowUnderground (and optionally undergroundItem); the DIRECT default never tunnels, and nor does a caller that leaves routing unset. A refused run is a normal response, not an error: possible is false, stopReason and the typed conflicts name the blocking tile, placed and failed are 0 and errors is empty, so read possible before treating placed 0 as success. """
  placePipe(input: BeltPipeRunInput!): ConnectEntitiesResult!
  """Plan and then build one connection in a single call and return both halves: the connectionPlan result and the placement result. This is the convenience wrapper for laying belts, pipes and power-pole chains without a second round trip, and it never places anything a plan refuses. dryRun true returns the plan and stops, so a caller can inspect steps and conflicts without spending items. Nothing is transactional: when the plan is possible the placement runs afterwards and its per-tile failures are reported in errors, so re-read the world after a failure instead of assuming a rollback."""
  buildConnection(input: ConnectEntitiesInput!, dryRun: Boolean! = false): BuildConnectionResult!
}

enum ConnectionKind {
  """Transport belts placed along the route, each facing the next tile."""
  BELT
  """Pipes placed along the route; the run may not touch pipe entities outside itself unless allowFluidAdjacency is true."""
  PIPE
  """One electric pole every floor(wire reach) route tiles so consecutive poles stay within wire distance."""
  POWER_POLE_CHAIN
}

enum ConnectionBend {
  """Plans both single-bend orientations and keeps the one with fewer conflicts; a tie keeps horizontal-first. A route that is already straight reports the orientation it lies on. ASTAR accepts only AUTO, because it derives corners from the shortest route."""
  AUTO
  """Walk the horizontal leg first, then the vertical leg."""
  HORIZONTAL_FIRST
  """Walk the vertical leg first, then the horizontal leg."""
  VERTICAL_FIRST
}

"""How the route between the endpoints is chosen."""
enum ConnectionRouting {
  """One straight or single-bend run; supports BELT, PIPE and POWER_POLE_CHAIN."""
  DIRECT
  """Bounded A* search for BELT and PIPE. Step costs: 1 per new tile, 0.25 per reused existing tile, 0.25 per bend, and 1.05 per tile a new underground half covers plus one tile for the exit half, so a tunnel is only chosen where the surface is blocked and an open straight stays a line of belts. Underground belts pair at an offset of at most the prototype's max underground distance; spans may pass under any entity except another underground belt, linked belt or pipe-to-ground. A new underground half may not be placed inside an existing same-name span on the same axis, because it would re-pair with that span's other half and break the existing line. With BELT routing a new tile also refuses a neighbouring belt that points into it unless allowBeltAdjacency is true; the goal tile may still be an existing belt the run side-loads into. ASTAR derives corners from the shortest route, so bend accepts AUTO only and any other value is rejected."""
  ASTAR
}

"""Why planning stopped."""
enum ConnectionStopReason {
  """DIRECT routing planned its fixed route."""
  DIRECT
  """ASTAR found a route."""
  FOUND
  """ASTAR exhausted every reachable state inside the search region."""
  NO_PATH
  """ASTAR hit maxExpandedTiles before reaching the goal; a larger limit or margin may succeed."""
  EXPANSION_LIMIT
  """An endpoint tile cannot hold the entity, so no route was searched."""
  ENDPOINT_BLOCKED
}

enum ConnectionConflictKind {
  """ASTAR exhausted the search region without reaching the goal."""
  NO_PATH
  """ASTAR hit maxExpandedTiles before reaching the goal."""
  EXPANSION_LIMIT
  """The tile refuses the entity; blockers lists colliding prototypes."""
  COLLISION
  """A same-name entity sits on the tile but faces another direction."""
  DIRECTION_MISMATCH
  """A pipe-like entity outside this run touches the tile, which would merge fluid networks. A fluid-port machine (assembler, furnace, refinery, chemical plant, pumpjack, drill, boiler, generator, heat exchanger, tank) counts when its fluidbox pipe connection reaches the tile, or when it exposes fluidboxes but reports no connection yet."""
  FLUID_ADJACENCY
  """An existing belt outside this run points into a tile the run would create, so it would side-load foreign items into the new line or flatten a planned corner. Pass allowBeltAdjacency to accept the merge."""
  BELT_ADJACENCY
  """The item does not place an entity of the kind's required type."""
  PROTOTYPE
  """A supplied prototype does not match the kind (for example a furnace with BELT)."""
  KIND_MISMATCH
  """The actor cannot reach the tile; only produced when reach enforcement is enabled."""
  REACH
  """The actor lacks the item count reported by needed."""
  INVENTORY
  """The engine rejected creation at this tile."""
  ENGINE
}

input ConnectionPlanInput {
  surface: String! = "nauvis"
  force: String! = "player"
  """Start tile; mutually exclusive with fromEntity. It snaps to the center of the tile containing it."""
  from: PositionInput
  """End tile; mutually exclusive with toEntity. It snaps to the center of the tile containing it."""
  to: PositionInput
  kind: ConnectionKind!
  """Entity item to place; defaults to transport-belt, pipe, or medium-electric-pole for the kind. The item must place a matching entity type."""
  item: String
  bend: ConnectionBend! = AUTO
  """Allow a PIPE run to touch pipes outside the run, which merges their fluid networks and can contaminate either side."""
  allowFluidAdjacency: Boolean! = false
  """DIRECT (default) or ASTAR; ASTAR supports BELT and PIPE only."""
  routing: ConnectionRouting! = DIRECT
  """ASTAR only: allow underground belt or pipe-to-ground spans."""
  allowUnderground: Boolean! = false
  """ASTAR only: item for underground halves; defaults to underground-belt for BELT and pipe-to-ground for PIPE and must place an underground-belt or pipe-to-ground entity. Requires allowUnderground."""
  undergroundItem: String
  """ASTAR only: cap on the offset between underground halves, 2 or more; the effective offset is the smaller of this and the prototype's max underground distance. Requires allowUnderground."""
  maxUndergroundDistance: Int
  """ASTAR only: areas, each at most 1024 tiles per side and at most 100 in total, where no entity may be placed. Underground spans may pass beneath them."""
  avoidAreas: [FactoryAreaInput!] = []
  """ASTAR only: let the route reuse existing same-name entities, cheaper than new tiles. A belt tile is reused only when it already faces the route's direction; reusing a pipe merges fluid networks, so it also needs allowFluidAdjacency. Existing entities at the two endpoints are always usable."""
  preferExisting: Boolean! = false
  """ASTAR only: search at most this many states, 1 through 200000; default 10000."""
  maxExpandedTiles: Int
  """ASTAR only: tiles of padding around the endpoint bounding box that the search may use, 0 through 256; default 32. The padded region may cover at most 65536 tiles."""
  searchMargin: Int
  """Start by entity instead of tile; replaces from. The planner picks the adjacent route tile and its orientation."""
  fromEntity: ConnectionEndpointInput
  """End at an entity instead of a tile; replaces to. A goal belt is side-loaded unless it faces the arrival head-on."""
  toEntity: ConnectionEndpointInput
  """Accept an existing belt outside the run that points into a new route tile, which side-loads foreign items into the run or turns a planned corner into a straight belt."""
  allowBeltAdjacency: Boolean! = false
}

"""An entity endpoint instead of a tile. The planner resolves the tile to use: the entity's own tile when it already holds the route entity, and otherwise the adjacent free tile on the chosen side, oriented away from the entity for a start and into it for a goal. For a PIPE run a fluid machine resolves to one of its fluidbox pipe-connection target tiles (the same tiles as inspect.fluidPorts target), not a tile beside its centre. No manual coordinates or directions are needed."""
input ConnectionEndpointInput {
  """Entity to connect, by unitNumber or exact center position; surface defaults to the plan surface."""
  entity: EntityRefInput!
  """Preferred side of the entity: auto (default), north, east, south or west. Other sides are tried when the preferred side has no free tile. For a PIPE run to a machine with several fluid ports this picks the port on that side; otherwise the port facing the other endpoint, then the first free port, wins."""
  side: String
  """Preferred belt lane for a side-loading goal: left, right or auto (default). Reported back as ConnectionPlan.lane when the route ends on an existing belt."""
  lane: String
}

input ConnectEntitiesInput {
  actor: ActorInput!
  surface: String! = "nauvis"
  """Force the run belongs to; must match the acting character's force."""
  force: String! = "player"
  from: PositionInput
  to: PositionInput
  kind: ConnectionKind!
  item: String
  """Engine direction of the single-tile run, 0 north, 4 east, 8 south or 12 west. Required when from and to resolve to the same tile, because the route itself cannot imply a heading there; rejected for runs of two or more tiles, whose directions follow the route. Without it a one-tile run used to place a north-facing entity silently."""
  direction: Int
  bend: ConnectionBend! = AUTO
  allowFluidAdjacency: Boolean! = false
  """DIRECT (default) or ASTAR; ASTAR supports BELT and PIPE only."""
  routing: ConnectionRouting! = DIRECT
  """ASTAR only: allow underground belt or pipe-to-ground spans."""
  allowUnderground: Boolean! = false
  """ASTAR only: item for underground halves; defaults to underground-belt for BELT and pipe-to-ground for PIPE and must place an underground-belt or pipe-to-ground entity. Requires allowUnderground."""
  undergroundItem: String
  """ASTAR only: cap on the offset between underground halves, 2 or more; the effective offset is the smaller of this and the prototype's max underground distance. Requires allowUnderground."""
  maxUndergroundDistance: Int
  """ASTAR only: areas, each at most 1024 tiles per side and at most 100 in total, where no entity may be placed. Underground spans may pass beneath them."""
  avoidAreas: [FactoryAreaInput!] = []
  """ASTAR only: let the route reuse existing same-name entities, cheaper than new tiles. A belt tile is reused only when it already faces the route's direction; reusing a pipe merges fluid networks, so it also needs allowFluidAdjacency. Existing entities at the two endpoints are always usable."""
  preferExisting: Boolean! = false
  """ASTAR only: search at most this many states, 1 through 200000; default 10000."""
  maxExpandedTiles: Int
  """ASTAR only: tiles of padding around the endpoint bounding box that the search may use, 0 through 256; default 32. The padded region may cover at most 65536 tiles."""
  searchMargin: Int
  """Start by entity instead of tile; replaces from. The planner picks the adjacent route tile and its orientation."""
  fromEntity: ConnectionEndpointInput
  """End at an entity instead of a tile; replaces to. A goal belt is side-loaded unless it faces the arrival head-on."""
  toEntity: ConnectionEndpointInput
  """Accept an existing belt outside the run that points into a new route tile, which side-loads foreign items into the run or turns a planned corner into a straight belt."""
  allowBeltAdjacency: Boolean! = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

"""Shared input for placePipe. kind is fixed by the mutation, so it is not accepted here."""
input BeltPipeRunInput {
  actor: ActorInput!
  surface: String! = "nauvis"
  force: String! = "player"
  from: PositionInput
  to: PositionInput
  item: String
  """Engine direction of the single-tile run, 0 north, 4 east, 8 south or 12 west. Required when from and to resolve to the same tile, because the route itself cannot imply a heading there; rejected for runs of two or more tiles, whose directions follow the route. Without it a one-tile run used to place a north-facing entity silently."""
  direction: Int
  bend: ConnectionBend! = AUTO
  allowFluidAdjacency: Boolean! = false
  routing: ConnectionRouting! = DIRECT
  allowUnderground: Boolean! = false
  undergroundItem: String
  maxUndergroundDistance: Int
  avoidAreas: [FactoryAreaInput!] = []
  preferExisting: Boolean! = false
  maxExpandedTiles: Int
  searchMargin: Int
  fromEntity: ConnectionEndpointInput
  toEntity: ConnectionEndpointInput
  allowBeltAdjacency: Boolean! = false
  message: String
}

"""Input for placeBelts: the connectEntities fields that apply to belts. kind is fixed to BELT and the pipe-only allowFluidAdjacency is not accepted."""
input BeltRunInput {
  actor: ActorInput!
  surface: String! = "nauvis"
  force: String! = "player"
  from: PositionInput
  to: PositionInput
  """Belt item, for example fast-transport-belt; defaults to transport-belt."""
  item: String
  """Engine direction of the single-tile run, 0 north, 4 east, 8 south or 12 west. Required when from and to resolve to the same tile; rejected for runs of two or more tiles."""
  direction: Int
  bend: ConnectionBend! = AUTO
  routing: ConnectionRouting! = DIRECT
  allowUnderground: Boolean! = false
  """Underground belt item for tunnel halves; defaults to underground-belt. Requires allowUnderground."""
  undergroundItem: String
  maxUndergroundDistance: Int
  avoidAreas: [FactoryAreaInput!] = []
  preferExisting: Boolean! = false
  maxExpandedTiles: Int
  searchMargin: Int
  fromEntity: ConnectionEndpointInput
  toEntity: ConnectionEndpointInput
  allowBeltAdjacency: Boolean! = false
  message: String
}

type ConnectionStep {
  """Tile-center position of the entity to place."""
  position: Position!
  """Engine direction the entity needs, toward the next step."""
  direction: Int!
  """The tile already holds the requested entity with the required direction, so nothing is placed or consumed."""
  existing: Boolean!
  """INPUT for the entrance and OUTPUT for the exit of an underground span, which skips the tiles between them; null for ordinary tiles. Underground steps use the plan's undergroundItem."""
  undergroundType: UndergroundBeltType
  """Cost units of this step; see ConnectionRouting.ASTAR."""
  cost: Float!
}

type ConnectionConflict {
  position: Position!
  kind: ConnectionConflictKind!
  """Colliding prototype names, one per name, sorted; empty when the refusal is not a collision."""
  blockers: [String!]!
  """True when the ground tile itself refuses the prototype."""
  terrain: Boolean!
  """Ground tile prototype name."""
  tile: String!
  message: String!
}

type ConnectionPlan {
  tick: Float!
  surface: String!
  force: String!
  kind: ConnectionKind!
  item: String!
  from: Position!
  to: Position!
  bend: ConnectionBend!
  """True when no conflict was found and needed entities can be placed."""
  possible: Boolean!
  """Entities of item that would be placed; excludes existing tiles and underground halves."""
  needed: Int!
  routing: ConnectionRouting!
  stopReason: ConnectionStopReason!
  """Item for underground halves; null unless the plan allows underground spans."""
  undergroundItem: String
  """Underground halves that would be placed."""
  undergroundNeeded: Int!
  """Total cost of the planned steps; for DIRECT it equals needed."""
  cost: Float!
  """States the search expanded; 0 for DIRECT."""
  expanded: Int!
  """Belt lane that receives the run when it ends by side-loading an existing belt: left or right from that belt's travel direction. Null when the goal is a new tile or the arrival is head-on."""
  lane: String
  steps: [ConnectionStep!]!
  conflicts: [ConnectionConflict!]!
}

"""Plan-then-build result: the read-only plan that was produced, and the placement that followed it."""
type BuildConnectionResult {
  tick: Float!
  surface: String!
  force: String!
  """True when the call was asked to plan only and placed nothing."""
  dryRun: Boolean!
  """The connectionPlan this call computed for the same input and surface state."""
  plan: ConnectionPlan!
  """Null on a dry run, and on a plan with conflicts, which places nothing."""
  result: ConnectEntitiesResult
}

type ConnectEntitiesResult {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity!
  kind: ConnectionKind!
  item: String!
  from: Position!
  to: Position!
  bend: ConnectionBend!
  """False when the mutation refused to place anything because the plan had conflicts."""
  possible: Boolean!
  routing: ConnectionRouting!
  stopReason: ConnectionStopReason!
  placed: Int!
  """Existing tiles that already held the requested entity."""
  skipped: Int!
  failed: Int!
  """Each created entity with the engine direction it was built with (0 north is reported as 0) and, for underground halves, undergroundType."""
  entities: [PlacedEntity!]!
  conflicts: [ConnectionConflict!]!
  errors: [BatchError!]!
}
