extend type Query {
  """
  Read-only single-snapshot view of a force's research state: researchEnabled, currentTechnology, progress, the engine
  research queue and one page of technologies. Filters are applied before pagination and may overlap: exact technology
  name, unlocksRecipe (technologies with an unlock-recipe effect for that recipe), and status ALL, RESEARCHED,
  AVAILABLE (enabled, unresearched and all prerequisites researched), LOCKED (unresearched but not available,
  including disabled) or IN_PROGRESS; available does not assert that labs, science packs or trigger conditions are
  satisfied. Technologies are sorted by name and paginated with limit 1..10000 and a zero-based offset, while
  pageInfo.total counts every match; progress and currentTechnology are null without an active research, and
  researchQueue may include the current research in engine order. Each technology carries level, savedProgress, sorted
  prerequisites and science ingredients, researchUnitCount already multiplied by the technology cost multiplier,
  researchUnitEnergy in ticks (60 per second), raw researchTrigger JSON for trigger technologies, and its effects with
  the complete modifier JSON. Unknown force, technology or recipe names, empty technology/unlocksRecipe strings, an
  invalid status or out-of-range limit/offset produce a GraphQL error; no state changes and no notification are made.
  """
  researchInsights(input: ResearchInsightsInput): ResearchInsights!
}

input ResearchInsightsInput {
  """Existing, non-empty force name."""
  force: String! = "player"
  """Exact technology name, if supplied."""
  technology: String
  """Exact recipe name; selects technologies with an unlock-recipe effect."""
  unlocksRecipe: String
  """Filters may overlap: an in-progress technology can also be available."""
  status: ResearchInsightsStatus! = ALL
  """Page size from 1 through 10000."""
  limit: Int! = 100
  """Zero-based, non-negative offset into technologies sorted by name."""
  offset: Int! = 0
}

enum ResearchInsightsStatus {
  """All technologies, subject to other filters."""
  ALL
  """Technologies already researched."""
  RESEARCHED
  """Enabled, unresearched technologies with researched prerequisites."""
  AVAILABLE
  """Unresearched technologies that are not available, including disabled ones."""
  LOCKED
  """The current technology, if any."""
  IN_PROGRESS
}

type ResearchInsights {
  tick: Float!
  force: String!
  researchEnabled: Boolean!
  currentTechnology: String
  """Fraction of current technology completed; null when none is active."""
  progress: Float
  """Queue order as reported by Factorio; may include current research."""
  researchQueue: [String!]!
  pageInfo: PageInfo!
  technologies: [ResearchInsightsTechnology!]!
}

type ResearchInsightsTechnology {
  name: String!
  enabled: Boolean!
  researched: Boolean!
  inProgress: Boolean!
  """Enabled, unresearched, and all prerequisites researched. Does not assert labs or trigger requirements are satisfied."""
  available: Boolean!
  level: Int!
  savedProgress: Float!
  prerequisites: [ResearchInsightsPrerequisite!]!
  scienceIngredients: [ResearchInsightsIngredient!]!
  """Research units for the current level, including the technology cost multiplier."""
  researchUnitCount: Int!
  """Energy per research unit, in ticks (60 ticks per second)."""
  researchUnitEnergy: Float!
  """Raw Factorio research trigger JSON, when this is a trigger technology."""
  researchTriggerJSON: String
  effects: [ResearchInsightsEffect!]!
}

type ResearchInsightsPrerequisite {
  name: String!
  researched: Boolean!
}

type ResearchInsightsIngredient {
  name: String!
  amount: Int!
}

type ResearchInsightsEffect {
  type: String!
  recipe: String
  """Complete Factorio TechnologyModifier serialized as JSON."""
  dataJSON: String!
}
