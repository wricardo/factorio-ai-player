extend type Query {
  """Lists trains on one surface with schedule, mode, cargo and fluid contents. One snapshot; all trains of the filtered surface are considered before pagination."""
  trains(input: TrainsInput = {}): TrainPage!
}

"""Surface and force must be non-empty names of existing objects. Limit is 1 through 1000; offset is zero-based and non-negative. station filters by a station name in the schedule."""
input TrainsInput {
  surface: String! = "nauvis"
  force: String! = "player"
  area: FactoryAreaInput
  station: String
  limit: Int! = 100
  offset: Int! = 0
}

type TrainPage {
  tick: Float!
  surface: String!
  force: String!
  pageInfo: PageInfo!
  trains: [TrainInfo!]!
}

"""A stopped or moving train. state is the engine defines.train_state value; schedule records carry the station name and the engine's wait condition where readable."""
type TrainInfo {
  tick: Float!
  surface: String!
  force: String!
  actor: ActorIdentity
  id: UnitNumber!
  status: EngineStatus!
  manualMode: Boolean!
  speed: Float!
  locomotives: Int!
  wagons: Int!
  frontPosition: Position
  schedule: [TrainScheduleRecord!]!
  cargo: [InventoryStack!]!
  fluids: [FluidContent!]!
}

type TrainScheduleRecord {
  station: String!
  waitCondition: TrainWaitCondition
  """Unmodified engine wait-condition JSON for unsupported or modded fields."""
  waitConditionRawJSON: String
}

enum TrainWaitConditionType {
  TIME
  INACTIVITY
  FULL
  EMPTY
  ITEM_COUNT
  FLUID_COUNT
  PASSENGER_PRESENT
  PASSENGER_NOT_PRESENT
  ROBOTS_INACTIVE
  CIRCUIT
  OTHER
}

enum TrainWaitCompareType { AND OR }

type TrainWaitCondition {
  type: TrainWaitConditionType!
  rawType: String!
  compareType: TrainWaitCompareType!
  ticks: Float
  condition: InserterCondition
}

input TrainWaitConditionInput {
  type: TrainWaitConditionType!
  compareType: TrainWaitCompareType = OR
  ticks: Float
  condition: SignalConditionInput
}

extend type Mutation {
  """Replaces a train's schedule with time-based records or clears it. The train must be addressable by unitNumber (or by prototype name and coordinates) and, when reach enforcement is enabled, reachable."""
  setTrainSchedule(input: SetTrainScheduleInput!): TrainInfo!
  """Sets a train's manual mode and optionally sends it to a named station."""
  trainControl(input: TrainControlInput!): TrainInfo!
}

"""Replace or clear one train schedule."""
input SetTrainScheduleInput {
  actor: ActorInput!
  target: EntityRefInput!
  records: [TrainScheduleRecordInput!]
  clear: Boolean! = false
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

input TrainScheduleRecordInput {
  station: String!
  waitCondition: TrainWaitConditionInput!
}

"""Control one train."""
input TrainControlInput {
  actor: ActorInput!
  target: EntityRefInput!
  manualMode: Boolean
  goToStation: String
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}

extend type Mutation {
  """Sets an entity's engine direction 0 through 15 without rotating in quarter turns. Use it for 8-way and 16-way prototypes such as rails and splitters."""
  setDirection(input: SetDirectionInput!): ActionResult!
}

"""Set one entity's canonical engine direction from 0 through 15."""
input SetDirectionInput {
  actor: ActorInput!
  target: EntityRefInput!
  direction: Int!
  """Print this text in-game to all connected players instead of the generated notification."""
  message: String
}
