extend type Query {
  """Renders a compact textual map of one required area (positive dimensions, at most 256 tiles per side) for headless clients that cannot take screenshots. The area is downsampled by cellSize = max(ceil(width / maxColumns), ceil(height / maxRows)), where maxRows and maxColumns are 1 through 64 (32 by default), so the grid never exceeds those bounds and cellSize exceeds 1 exactly when downsampling happened; truncated mirrors that. Each cell shows the highest-priority entity whose center falls in it, or water when the cell's anchor tile carries a pumpable fluid, or `.` when empty. Priority is character, machine, inserter, belt, pipe or fluid entity, pole, chest, resource, tree, rock, cliff, then everything else; ties are broken by prototype name, x, y, then unit number. Built entities are limited to the selected force while natural entities are included regardless of force; layer FACTORY keeps only chest rank and above, and RESOURCES keeps only resource entities, with water as terrain. legend maps every emitted character back to prototype name, type, first entity unit number, and cell count, plus `.` for empty and `~` for water; at most 64 distinct prototype characters exist and further prototypes collapse into one `?` row named other. Output is one snapshot with no pagination, and an invalid surface, force, area or dimension fails the query."""
  mapArea(input: MapAreaInput!): MapArea!
}

enum MapLayer {
  """Built entities, characters, resources, trees, rocks, cliffs and water."""
  ALL
  """Characters and built factory entities only; natural obstacles and resources are omitted."""
  FACTORY
  """Resource entities only, with water as terrain."""
  RESOURCES
}

input MapAreaInput {
  surface: String! = "nauvis"
  force: String! = "player"
  """Area bounds match the other world scans: positive dimensions of at most 256 tiles per side."""
  area: FactoryAreaInput!
  """Maximum output rows, 1 through 64."""
  maxRows: Int! = 32
  """Maximum output columns, 1 through 64."""
  maxColumns: Int! = 32
  layer: MapLayer! = ALL
}

type MapArea {
  tick: Float!
  surface: String!
  force: String!
  area: WorldArea!
  """Tiles per cell; greater than 1 when the area was downsampled."""
  cellSize: Float!
  columns: Int!
  rows: [String!]!
  legend: [MapLegendEntry!]!
  """True when cellSize is greater than 1."""
  truncated: Boolean!
}

type MapLegendEntry {
  char: String!
  """Prototype name, `empty`, or `water`."""
  name: String!
  """Entity type, `empty`, or `tile`."""
  type: String!
  """Unit number of the first entity of this prototype in the scan; null for empty and water."""
  unitNumber: UnitNumber
  """Number of cells showing this character."""
  count: Int!
}
